#!/usr/bin/env python3
"""Exercise COMMAND's help dispatch and XCOPY against the standalone viewer."""
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
table = (root / "commands/command/tdata.asm").read_text().split("COMTAB\tDB")[1]
names = re.findall(r'DB\s+\d+,"([A-Z]+)",', "DB" + table.split("Terminate command table")[0])
external = """append.exe assign.com attrib.exe backup.com chkdsk.com comp.com debug.com
deltree.exe diskcomp.com diskcopy.com edlin.com exe2bin.exe fastopen.exe fc.exe
fdisk.exe find.exe format.com graftabl.com graphics.com join.exe keyb.com label.com
mem.exe mode.com more.com nlsfunc.exe print.com recover.com replace.exe restore.com
select.com select.exe share.exe sort.exe subst.exe sys.com tree.com loadfix.com move.exe xcopy.exe""".split()
with tempfile.TemporaryDirectory() as work:
    drive = Path(work)
    dos = drive / "DOS"
    dos.mkdir()
    for program in ["command.com", *external]:
        shutil.copy(root / "commands" / Path(program).stem / program, drive)
    shutil.copy(root / "commands/help/help.com", dos)
    database = dos / "doshelp.hlp"
    database.write_bytes((root / "doshelp/doshelp.hlp").read_bytes().replace(b"\n", b"\r\n"))

    def run(*args, stdin=None):
        result = subprocess.run(
            ["emu2", *args, "--", r"PATH=C:\DOS"], cwd=drive, capture_output=True, input=stdin,
            env=dict(os.environ, EMU2_DRIVE_C=work, EMU2_DOSVER="4.00"), timeout=5)
        return result.returncode, result.stdout, result.stderr

    def page(topic):
        expected = run("DOS/help.com", topic)
        assert expected[0] == 0 and expected[1], topic
        return expected

    # A valid SYS operand must reach drive validation after the help check.
    # The temporary C: is the default drive, so SYS rejects it before writing.
    assert run("sys.com", "C:")[2] == b"Cannot specify default drive\r\n"
    for program in external:
        assert run(program, "/?") == page(Path(program).stem.upper()), program
    # DEBUG forwards the tail after the filename to the debuggee's PSP.
    (drive / "probe.com").write_bytes(b"\xcd\x20")
    debug = run("debug.com", "probe.com", "/?", stdin=b"d 80 85\r\nq\r\n")
    assert b"2F 3F" in debug[1], debug
    assert run("command.com", "/c", "ECHO", "/?\t") == page("ECHO")
    assert run("DOS/help.com", "/?") == page("HELP")
    for name in names:
        assert run("command.com", "/c", name, "/?") == page(name), name
    assert run("command.com", "/?") == page("COMMAND")
    assert run("command.com", "/c", "DIR/W/?") == page("DIR")
    assert run("command.com", "/c", "ECHO", "literal", "/?")[1] == b"literal /?\r\n"
    assert run("xcopy.exe", "MISSING", "DEST", "/?") == page("XCOPY")
    assert not (drive / "dest").exists()

    missing = (1, b"", b"No help available\r\n")
    for file in (database, dos / "help.com"):
        file.unlink()
        for program in external:
            assert run(program, "/?") == missing, (file.name, program)
        for args in (("command.com", "/?"), ("command.com", "/c", "DIR", "/?"),
                     ("xcopy.exe", "/?")):
            assert run(*args) == missing, (file.name, args)
    print(f"PASS COMMAND, {len(names)} internal command names, HELP, and {len(external)} external utilities")
