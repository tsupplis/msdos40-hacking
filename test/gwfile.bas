10 REM The caller fills disposable drive A before each run.
20 IF ENVIRON$("GWFILE")<>"CHECK" THEN ERROR 5
25 OPEN "GUARD.DAT" FOR OUTPUT AS #1:CLOSE #1
30 ON ERROR GOTO 190
32 OPEN "GUARD.DAT" FOR INPUT AS #1
34 KILL "GUARD.DAT"
36 PRINT "OPEN FILE DELETED":SYSTEM
38 CLOSE #1:KILL "GUARD.DAT"
40 FOR I=1 TO 30
50 OPEN "A:GWFILE.BAS" FOR INPUT AS #I
60 NEXT I
70 PRINT "HANDLE LIMIT MISSED":SYSTEM
80 CLOSE
90 OPEN "A:RETRY.DAT" FOR OUTPUT AS #1
100 PRINT #1,STRING$(128,65);
110 PRINT #1,"B";
120 CLOSE #1:SYSTEM
190 IF ERL=34 AND ERR=55 THEN PRINT "OPEN FILE PROTECTED":RESUME 38
200 IF ERL=50 AND ERR=67 AND EXTERR(0)=4 THEN PRINT "HANDLE LIMIT":RESUME 80
210 IF ERL=110 AND ERR=61 THEN PRINT "DISK FULL":KILL "A:FILL.TMP":RESUME
220 PRINT "UNEXPECTED";ERR;ERL:SYSTEM
