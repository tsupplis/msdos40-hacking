#!/usr/bin/env python3
"""Verify FAT16 directory and file operations at the 32 MiB boundary."""
import hashlib
import argparse
import os
import re
from pathlib import Path
import shutil
import struct
import subprocess
import tempfile

from file32 import verify_file32
from hmaprobe import install_probe

layouts = [("near", ""), ("high", "dos=high,umb\ndevice=himem.sys\n")]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("layout", nargs="?", choices=[row[0] for row in layouts])
selected = parser.parse_args().layout

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
sector = 512
hidden = 17
sectors = 1024 * 4 * 17
names = ("BEFORE", "CROSS", "AFTER")
starts = (0xfffd, 0xffff, 0x10001)


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def make_fixture(folder):
    raw = folder / "base.img"
    volume = f"{raw}@@{hidden * sector}"
    with raw.open("wb") as f:
        f.truncate(sectors * sector)
        mbr = bytearray(sector)
        # Type 06h. CHS (0,1,1) through (1023,3,17), inclusive.
        struct.pack_into("<B3sB3sII", mbr, 446, 0, bytes([1, 1, 0]), 6,
                         bytes([3, 0xd1, 0xff]), hidden, sectors - hidden)
        mbr[510:] = b"\x55\xaa"
        f.write(mbr)
    subprocess.run(["mformat", "-i", volume, "-T", str(sectors-hidden), "-h", "4",
                    "-s", "17", "-H", str(hidden), "-c", "2", "-v", "DIR32", "::"], check=True)
    with raw.open("r+b") as f:
        f.seek(hidden * sector + 3)
        f.write(b"MSDOS4.0")
        f.seek(hidden * sector)
        bpb = f.read(sector)
    reserved, = struct.unpack_from("<H", bpb, 14)
    copies = bpb[16]
    roots, = struct.unpack_from("<H", bpb, 17)
    fat_len, = struct.unpack_from("<H", bpb, 22)
    root_sector = reserved + copies * fat_len
    data_sector = root_sector + (roots * 32 + sector - 1) // sector
    require(struct.unpack_from("<HB", bpb, 11) == (sector, 2) and copies == 2 and roots == 512
            and struct.unpack_from("<II", bpb, 28) == (hidden, sectors-hidden),
            "unexpected FAT16 BPB")
    require((starts[0]-data_sector) % 2 == 0, "target is not cluster-aligned")
    clusters = [(s-data_sector)//2 + 2 for s in starts]
    # A real file owns the prefix. The first three free clusters are the targets.
    pad = folder / "pad.bin"
    with pad.open("wb") as f:
        f.write(hashlib.shake_128(b"PD0255 seed file").digest((clusters[0]-2) * 2 * sector))
    subprocess.run(["mcopy", "-i", volume, pad, "::PAD.BIN"], check=True)
    with raw.open("r+b") as f:
        # Distinct nonzero bytes in each target sector and its two neighbours.
        for i in range(starts[0]-1, starts[-1]+3):
            f.seek((hidden+i)*sector)
            f.write(bytes([0xa0+i-starts[0]])*sector)
    return raw, (hidden+reserved)*sector, fat_len*sector, (hidden+root_sector)*sector, clusters


def verify(before, after, fat, length, directory, clusters):
    expected = bytearray(before)
    for name, lba, cluster in zip(names, starts, clusters):
        for base in (fat, fat+length):
            pos = base + 2*cluster
            require(before[pos:pos+2] == bytes(2) and
                    int.from_bytes(after[pos:pos+2], "little") >= 0xfff8, f"{name}: FAT allocation")
            expected[pos:pos+2] = after[pos:pos+2]
        # Accept the guest's timestamps. All other changes outside the new
        # entries and allocated clusters must compare equal to the fixture.
        entry = next((p for p in range(directory, directory+512*32, 32)
                      if after[p:p+11] == name.encode().ljust(11)), None)
        require(entry is not None and before[entry] == 0, f"{name}: missing new root entry")
        record = after[entry:entry+32]
        require(record[11] == 0x10 and struct.unpack_from("<HI", record, 26) == (cluster, 0),
                f"{name}: wrong root attributes, cluster or size")
        expected[entry:entry+32] = record
        pos = (hidden+lba)*sector
        for slot, (label, link) in enumerate([(b".", cluster), (b"..", 0)]):
            dot = bytearray(32)
            dot[:11] = label.ljust(11)
            dot[11] = 0x10
            dot[22:26] = record[22:26]
            struct.pack_into("<H", dot, 26, link)
            expected[pos+slot*32:pos+(slot+1)*32] = dot
        expected[pos+64:pos+2*sector] = bytes(2*sector-64)
    require(after[fat:fat+length] == after[fat+length:fat+2*length], "FAT copies differ")
    require(len(after) == len(before), "disk image size changed")
    if expected != after:
        bad = next(i for i,(a,b) in enumerate(zip(expected, after)) if a != b)
        raise RuntimeError(f"disk mismatch at absolute sector {bad//sector}, "
                           f"volume sector {bad//sector-hidden}, byte {bad%sector}")


with tempfile.TemporaryDirectory(dir=work) as directory_name:
    folder = Path(directory_name)
    raw, fat, length, directory, clusters = make_fixture(folder)
    before = raw.read_bytes()
    boot = folder / "boot.img"
    shutil.copyfile(os.environ.get("IMG", root/"media/msdos40_full.img"), boot)
    for binary in (root/"kernel/dos/msdos.sys", root/"kernel/bios/io.sys"):
        contents = subprocess.check_output(["mtype", "-i", boot, "::"+binary.name])
        require(contents == binary.read_bytes(), f"boot image differs from {binary}")
        print(binary.name, hashlib.sha256(contents).hexdigest(), flush=True)
    install_probe(root, folder, boot)
    probe = folder / "file32.com"
    subprocess.run(["nasm", "-f", "bin", root/"test/file32.asm", "-o", probe], check=True)
    subprocess.run(["mcopy", "-i", boot, probe, "::FILE32.COM"], check=True)
    subprocess.run(["mcopy", "-o", "-i", boot, root/"pce/pcehimem.sys", "::HIMEM.SYS"], check=True)
    batch = folder / "dir32.bat"
    for mode, config in layouts:
        if selected and mode != selected:
            continue
        disk = folder / (mode+".pimg")
        subprocess.run(["pce-img", "convert", "-q", "-g", "1024", "4", "17", "-O", "pimg", raw, disk], check=True)
        batch.with_suffix(".cfg").write_text(config)
        for reboot in (False, True):
            commands = [f"hmaio {mode[0]}!"]
            if not reboot:
                commands.append("mem /c")
            for name in names:
                if not reboot:
                    commands.append(f"md C:\\{name}")
                commands.append(f"if exist C:\\{name}\\NUL echo OK-{name}")
            batch.write_text("\n".join(commands)+"\n")
            output = subprocess.check_output([root/"test/run_tests", batch],
                        env=dict(os.environ, IMG=str(boot), PCE_TEST_HD=str(disk))).splitlines()
            if not reboot:
                rows = [row for row in output if row.startswith(b"SHARE ")]
                require(len(rows) == 1, f"{mode}: expected one automatic SHARE module: {rows!r}")
                fields = re.findall(rb"([\d,]+)\s+\(", rows[0])
                total, conventional, upper = [int(n.replace(b",", b"")) for n in fields]
                require(total > 0 and (conventional, upper) ==
                        ((0, total) if mode == "high" else (total, 0)),
                        f"{mode}: wrong SHARE placement: {rows[0]!r}")
            for marker in [b"LAYOUT PASS", b"ENDTEST"] + [("OK-"+n).encode() for n in names]:
                require(output.count(marker) == 1, f"{mode}: missing {marker!r} in {output!r}")
            saved = folder / "saved.img"
            saved.unlink(missing_ok=True)
            subprocess.run(["pce-img", "convert", "-q", "-O", "img", disk, saved], check=True)
            verify(before, saved.read_bytes(), fat, length, directory, clusters)
        print(f"PASS {mode}: three directory clusters verified before and after reboot", flush=True)

        def run_guest(action):
            batch.write_text(f"REM @seconds 60\nhmaio {mode[0]}!\nfile32 {action}\n")
            run = subprocess.run([root/"test/run_tests", batch], stdout=subprocess.PIPE,
                                 env=dict(os.environ, IMG=str(boot), PCE_TEST_HD=str(disk)))
            output = run.stdout.splitlines()
            require(run.returncode == 0, f"{mode}/{action}: DOS run failed: {output!r}")
            for marker in (b"LAYOUT PASS", b"FILE32 PASS", b"ENDTEST"):
                require(output.count(marker) == 1, f"{mode}/{action}: missing {marker!r} in {output!r}")

        verify_file32(folder, disk, mode, run_guest, fat, length, directory,
                      directory + 512*32, (clusters[0]-2)*1024)
