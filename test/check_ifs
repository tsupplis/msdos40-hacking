#!/usr/bin/env python3
"""Verify the retired IFS interfaces against the linked kernel and SHARE."""
from pathlib import Path
import argparse
import os
import re
import shutil
import subprocess
import tempfile

layouts = [("low", "", "share"), ("high", "dos=high,umb\ndevice=himem.sys\n", "share /nc")]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("layout", nargs="?", choices=[row[0] for row in layouts])
selected = parser.parse_args().layout

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as directory:
    folder = Path(directory)
    image = folder / "system.img"
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40_full.img"), image)
    for path in ("kernel/dos/msdos.sys", "kernel/bios/io.sys", "commands/share/share.exe"):
        binary = root / path
        if subprocess.check_output(["mtype", "-i", image, "::" + binary.name]) != binary.read_bytes():
            raise SystemExit(f"Test image differs from {binary}")

    link_map = (root / "kernel/dos/msdos.map").read_text()
    defines = []
    for name in ("SWAP_START", "Swap_Always", "SWAP_END"):
        match = re.search(r"^\s*0000:([0-9A-Fa-f]+)\s+" + name + r"\s*$", link_map, re.M)
        if not match:
            raise SystemExit(f"Missing {name} in DOS map")
        defines.append(f"-D{name.upper()}=0x{match[1]}")
    probe = folder / "ifsprobe.com"
    subprocess.run(["nasm", "-f", "bin", *defines, root / "test/ifsprobe.asm", "-o", probe], check=True)
    for source, target in [(probe, "::IFSPROBE.COM"), (root / "extra/pcehimem.sys", "::HIMEM.SYS")]:
        subprocess.run(["mcopy", "-o", "-i", image, source, target], check=True)
    batch = folder / "ifs.bat"
    for mode, config, share in layouts:
        if selected and mode != selected:
            continue
        batch.write_text(f"ifsprobe install\n{share}\nifsprobe\n")
        batch.with_suffix(".cfg").write_text(config)
        output = subprocess.check_output([root / "test/run_tests", batch],
                                         env=dict(os.environ, IMG=str(image))).splitlines()
        if output.count(b"IFS PASS") != 1 or b"IFS FAIL" in output or b"ENDTEST" not in output:
            raise SystemExit(f"{mode}: {output!r}")
        print(f"PASS IFS {mode}", flush=True)
