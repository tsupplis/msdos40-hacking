def prepare_group(ids, folder, drive):
    # RUN clears BASIC variables and opens the next fixture. Keeping the
    # original line numbers preserves ERL and the targets of GOTO and RESUME.
    programs = []
    for i, n in enumerate(ids):
        lines = ['10 OPEN "GROUP.OUT" FOR APPEND AS #1:ON ERROR GOTO 10000',
                 f'20 PRINT #1,"CASE {i}"']
        lines.extend(f"{100+j*10} {line}" for j, line in enumerate(cases[n].split("~")))
        lines.extend(['9800 PRINT #1,"DONE":GOTO 10010',
                      '10000 PRINT #1,"ERROR";ERR;ERL:RESUME 10010'])
        next_case = f'RUN "P{i+1}.BAS"' if i+1 < len(ids) and n != 46 else "SYSTEM"
        lines.append("10010 CLOSE:" + next_case)
        program = folder / f"P{i}.BAS"
        program.write_bytes(("\r\n".join(lines) + "\r\n").encode("ascii"))
        programs.append(program)
    command("mcopy", "-i", drive, *programs, "::")


def run_group(ids, version, folder, data, monitor):
    drive = folder / "group.img"
    shutil.copyfile(data, drive)
    prepare_group(ids, folder, drive)
    put(drive, folder, "RUN.BAT", f"@echo off\nb:\n{version} P0.BAS\necho FINISHED > DONE.TXT\n")
    start_probe(monitor, drive)
    wait_done(drive)
    monitor.request("stop")
    monitor.request("eject probe")
    if not finished(drive):
        raise RuntimeError(f"{version}: BASIC did not return to DOS")
    return group_results(ids, drive, "GROUP.OUT")


def group_results(ids, drive, filename):
    output = read(drive, filename) or ""
    parts = re.split(r"^CASE (\d+)\n", output, flags=re.M)
    if parts[0] or parts[1::2] != list(map(str, range(len(ids)))):
        raise RuntimeError(f"{filename}: incomplete BASIC batch")
    return [{"RESULT.TXT": part.rstrip("\n")} for part in parts[2::2]]


