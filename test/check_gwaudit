def command(*argv, **kwargs):
    return subprocess.run(argv, check=True, stdout=subprocess.DEVNULL, **kwargs)


def install(image, host, name):
    command("mcopy", "-o", "-i", image, host, "::" + name)


def put(image, folder, name, content):
    host = folder / name
    host.write_bytes(content.replace("\n", "\r\n").encode("ascii"))
    install(image, host, name)


def read(image, name):
    r = subprocess.run(["mtype", "-i", image, "::" + name], capture_output=True)
    if r.returncode:
        return None
    return r.stdout.partition(b"\x1a")[0].decode("cp437").replace("\r\n", "\n").rstrip("\n")


