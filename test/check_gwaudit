class Monitor:
    def __init__(self, vm, folder):
        self.vm = vm
        self.dump = folder / "dump.bin"
        self.response()

    def response(self):
        data = bytearray()
        while not data.endswith(b"(qemu) "):
            if not select.select([self.vm.stdout], [], [], 8)[0]:
                raise TimeoutError("QEMU monitor stopped responding")
            chunk = os.read(self.vm.stdout.fileno(), 8192)
            if not chunk:
                raise RuntimeError("QEMU monitor closed")
            data.extend(chunk)
        # HMP echoes the command on the first line, followed by its diagnostics.
        return bytes(data).split(b"\r\n", 1)[-1].removesuffix(b"(qemu) ").strip()

    def request(self, text):
        self.vm.stdin.write(text.encode() + b"\n")
        self.vm.stdin.flush()
        diagnostic = self.response()
        if diagnostic:
            raise RuntimeError(f"QEMU {text}: {diagnostic!r}")

    def memory(self, address, size):
        self.request(f'pmemsave {address} {size} "{self.dump}"')
        return self.dump.read_bytes()

    def screen(self):
        data = self.memory("0xb8000", 4000)[::2].decode("cp437")
        return [data[k:k+80].rstrip() for k in range(0, 1920, 80)]


def monitor_case(monitor, n):
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        rows = monitor.screen()
        if any("READY" in row for row in rows) and any(row.startswith("Ok") for row in rows):
            break
        time.sleep(.05)
    else:
        return {"incomplete": True, "screen": [r for r in rows if r]}
    keys = {" ": "spc", ",": "comma", ".": "dot", "space": "spc"}
    def wait_ticks(count):
        # The BIOS clock advances at about 18 Hz. Pace input in guest time so
        # a descheduled VM can process the key release before the next press.
        def ticks():
            return int.from_bytes(monitor.memory("0x46c", 4), "little")

        start = ticks()
        deadline = time.monotonic() + 5
        while (ticks() - start) % 0x1800B0 < count:
            if time.monotonic() >= deadline:
                raise TimeoutError(f"case {n}: BIOS clock stopped during keyboard input")
            time.sleep(.025)

    def key(k):
        monitor.request("sendkey " + k + " 20")
        wait_ticks(2)

    for part in editor[n].split("|"):
        if part in ("ret","left","right","up","down","insert","delete","backspace","esc","tab","home","end","space") or part.startswith(("ctrl-","shift-")) or re.fullmatch(r"f\d+", part):
            key(keys.get(part, part))
        else:
            for c in part:
                key("shift-" + c.lower() if c.isupper() else keys.get(c,c))
    wait_ticks(4)
    rows = monitor.screen()
    cursor = monitor.memory("0x450", 2)
    result = {"screen": "\n".join(rows).rstrip(), "cursor": list(cursor)}
    return result

