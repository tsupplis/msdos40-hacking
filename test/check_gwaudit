def command_result(n, tag, work):
    drive = work / "b.img"
    capture = subprocess.check_output(["mtype", "-i", drive, f"::{tag}{n}.OUT"])
    capture = capture.decode("cp437").replace("\r\n", "\n")
    if n == 277:
        return {"CAPTURE.OUT": capture}
    report = read(drive, f"{tag}{n}.DAT")
    if report is None:
        raise RuntimeError(f"{tag}{n}: missing BASIC report")
    if n == 53:
        # Disk contents change between builds. Check the actual free count first.
        listing = subprocess.check_output(["mdir", "-i", work / "boot.img", "::"], env=dict(os.environ, LC_ALL="C"))
        space = re.search(rb"([\d ]+) bytes free", listing).group(1).replace(b" ", b"").decode()
        capture = capture.replace(f" {space} Bytes free\n", " <disk free bytes> Bytes free\n")
    result = {"RESULT.TXT": report, "CAPTURE.OUT": capture}
    if n in (145, 146):
        for ext in ("DAT", "OUT"):
            entry = read(drive, f"{tag}{n}M.{ext}")
            if entry is None:
                raise RuntimeError(f"{tag}{n}: missing /M shell result")
            result["/M " + ext] = entry
    if n == 286:
        for paras in [300, 3071, 3072] + [size for size, _ in small_blocks]:
            boundary = read(drive, f"{tag}{paras}.OUT")
            if boundary is None:
                raise RuntimeError(f"{tag}{paras}: missing /M boundary result")
            result[str(paras)] = boundary
    return result


def pce_group(ids, folder, image, data):
    requested = ids
    separate = [n for n in ids if n in command_inputs]
    ids = [n for n in ids if n not in command_inputs]
    if ids:
        prepare_group(ids, folder, data)
    prepare_commands(separate, folder, data)
    if {46, 231, 232}.intersection(ids):
        driver = folder / "gwdev.sys"
        command("nasm", "-f", "bin", root / "test/gwdev.asm", "-o", driver)
        install(data, driver, "GWDEV.SYS")
        (folder / "audit.cfg").write_text("DEVICE=B:\\GWDEV.SYS\n")
    batch = folder / "audit.bat"
    # The nested critical error in case 46 leaves EXTERR set across RUN in
    # 3.23. Start the following fixture in a fresh interpreter on the same boot.
    starts = [0] if ids else []
    if 46 in ids and ids.index(46) + 1 < len(ids):
        starts.append(ids.index(46) + 1)
    commands = ["b:", "date 01-03-2001"]
    serial = bool({233, 395, 396, 397}.intersection(ids))
    if serial:
        commands.append("ctty con")  # Release COM1 while BASIC configures the UART.
    if args.share:
        commands.append(r"A:\SHARE.EXE")
    for version in ("ref", "exe"):
        commands.extend(f"{version} P{i}.BAS" for i in starts)
        if ids:
            commands.append(f"ren GROUP.OUT {version}.OUT")
        tag = version[0]
        for n in separate:
            if n == 277:
                commands.append(f"{version} <C277.IN >{tag}277.OUT")
                continue
            option = " " + switches[n] if n in switches else ""
            commands += [f"{version} C{n}.BAS{option} <C{n}.IN >{tag}{n}.OUT",
                         f"if exist REPORT.OUT ren REPORT.OUT {tag}{n}.DAT"]
            if n in (145, 146):
                commands += [f"{version} C{n}.BAS /M:,4096 <C{n}.IN >{tag}{n}M.OUT",
                             f"ren REPORT.OUT {tag}{n}M.DAT"]
            if n == 286:
                commands.append(f"{version} MTINY.BAS /M:,300 <C286.IN >{tag}300.OUT")
                for paras in (3071, 3072):
                    commands.append(f"{version} C286.BAS /M:49152,{paras} <C286.IN >{tag}{paras}.OUT")
                commands.append("del REPORT.OUT")
                for paras, opts in small_blocks:
                    commands.append(f"{version} MTINY.BAS {opts}/M:,{paras} <C286.IN >{tag}{paras}.OUT")
        if version == "ref":
            commands.append("if exist R.DAT del R.DAT")
    if serial:
        commands.append("ctty com1")
    batch.write_text("\n".join(commands) + "\n")
    work = folder / "pce"
    run = subprocess.run([root / "test/run_tests", batch], cwd=root, capture_output=True,
                         env=dict(os.environ, IMG=str(image), PCE_TEST_WORK=str(work),
                                  PCE_TEST_FLOPPY_B=str(data), PCE_TEST_BOOT_READONLY="1"))
    if run.returncode:
        raise RuntimeError((run.stdout + run.stderr).decode("cp437") + "\n" +
                           (work / "pce.log").read_text(errors="replace")[-2000:])
    results = []
    for version in ("ref", "exe"):
        rows = dict(zip(ids, group_results(ids, work / "b.img", version + ".OUT"))) if ids else {}
        rows.update((n, command_result(n, version[0], work)) for n in separate)
        results.append([rows[n] for n in requested])
    return results


def start_probe(monitor, drive):
    monitor.request("loadvm ready")
    monitor.request(f'change probe "{drive}" raw')
    monitor.request("cont")
    monitor.request("sendkey ret 20")


def finished(drive):
    return (read(drive, "DONE.TXT") or "").strip() == "FINISHED"


def wait_done(drive):
    deadline = time.monotonic() + 12
    while not finished(drive) and time.monotonic() < deadline:
        time.sleep(.05)


def run_case(n, version, folder, data, monitor, printer):
    drive = folder / "case.img"
    shutil.copyfile(data, drive)
    body = cases[n].split("~")
    program = ['10 OPEN "RESULT.TXT" FOR OUTPUT AS #1:ON ERROR GOTO 10000']
    program.extend(f"{100+i*10} {line}" for i, line in enumerate(body))
    program.extend(['9800 PRINT #1,"DONE":CLOSE:SYSTEM',
                    '10000 PRINT #1,"ERROR";ERR;ERL:CLOSE:SYSTEM'])
    if n in editor:
        program = ['10 KEY OFF:CLS:PRINT "READY":END']
    put(drive, folder, "CASE.BAS", "\n".join(program) + "\n")
    control = direct.get(n, {70: 'A,17', 72: 'ABC', 81: 'one, two', 120: '203',
                             151: 'CONT', 146: 'EXIT'}.get(n, ''))
    put(drive, folder, "IN.TXT", control + "\nSYSTEM\n")
    exe = version
    invocation = exe if n in direct else exe + " CASE.BAS"
    if n in switches and switches[n]:
        invocation += " " + switches[n]
    if n in direct or n in streams or n in (39, 84, 146, 151, 236):
        invocation += " <IN.TXT"
    if n in direct or n in streams or n in switches:
        invocation += " >>CAPTURE.OUT" if n == 279 else " >CAPTURE.OUT"
    if n in editor:
        invocation = version + " CASE.BAS"
    if n == 279:
        put(drive, folder, "CAPTURE.OUT", "PREFIX\n")
    put(drive, folder, "RUN.BAT", f"@echo off\nb:\n{invocation}\necho FINISHED > DONE.TXT\n")
    printer_start = printer.stat().st_size
    start_probe(monitor, drive)
    if n in editor:
        result = monitor_case(monitor, n)
    else:
        wait_done(drive)
    monitor.request("stop")
    monitor.request("eject probe")
    if n not in editor:
        result = {name: value for name in ("RESULT.TXT", "VALUE.OUT", "CLEAR.OUT", "LIST.OUT", "CAPTURE.OUT")
                  if (value := read(drive, name)) is not None}
        if not finished(drive):
            result["incomplete"] = True
    with printer.open("rb") as capture:
        capture.seek(printer_start)
        output = capture.read()
    if output or n == 393:
        result["LPT"] = output.hex()
    return result


def run_batch(ids, version, template, data):
    with tempfile.TemporaryDirectory(dir="/tmp") as tmp:
        folder = Path(tmp)
        printer = folder / "printer"
        with subprocess.Popen(["qemu-system-i386", "-accel", "tcg", "-m", "16",
                               "-rtc", "base=2001-01-03T12:34:00,clock=vm", "-display", "none",
                               "-serial", "null", "-parallel", "file:" + str(printer), "-monitor", "stdio",
                               "-boot", "a", "-drive", f"if=floppy,index=0,format=raw,snapshot=on,file={template}",
                               "-drive", "if=floppy,index=1,id=probe"],
                              stdin=subprocess.PIPE, stdout=subprocess.PIPE) as vm:
            try:
                monitor = Monitor(vm, folder)
                deadline = time.monotonic() + 12
                while "AUDIT READY" not in monitor.screen():
                    if time.monotonic() >= deadline:
                        raise TimeoutError("DOS did not reach the audit batch")
                    time.sleep(.05)
                monitor.request("stop")
                monitor.request("savevm ready")
                shared = [n for n in ids if n in grouped]
                observations = iter(run_group(shared, version, folder, data, monitor) if shared else [])
                results = []
                for index, n in enumerate(ids, 1):
                    if n in grouped:
                        results.append(next(observations))
                    else:
                        results.append(run_case(n, version, folder, data, monitor, printer))
                    if index % 50 == 0 or index == len(ids):
                        print(f"{version}: {index}/{len(ids)} probes completed", file=sys.stderr)
                return results
            finally:
                vm.terminate()
                vm.wait(timeout=5)


def main():
    available = grouped | command_inputs.keys()
    if args.share:
        available = share_cases | {110}  # Repeat OPEN ACCESS READ SHARED with the resident installed.
    elif args.editor:
        available = gweditpce.cases
    elif args.qemu:
        available = cases.keys() - gweditpce.cases - share_cases - command_inputs.keys() - {45, 46, 231, 232}
        if command_inputs.keys() & set(args.ids):
            parser.error("these command-line probes run on PCE, omit --qemu")
        if {45, 46, 231, 232}.intersection(args.ids):
            parser.error("these DOS device probes require the PCE test configuration")
        if gweditpce.cases.intersection(args.ids):
            parser.error("these interactive cases now run on PCE, omit --qemu")
    ids = args.ids or sorted(available)
    if set(ids).intersection(share_cases) and not args.share:
        parser.error("these file-locking probes require --share")
    if args.share and set(ids) - available:
        parser.error("select the SHARE locking probes separately")
    live_editor = args.editor or (not args.qemu and set(ids) <= gweditpce.cases)
    if live_editor and set(ids) - gweditpce.cases:
        parser.error("select PCE editor cases separately from BASIC program probes")
    if not (args.share or args.qemu or live_editor) and set(ids) - grouped - command_inputs.keys():
        parser.error("requested case has no PCE probe yet (historical runner: --qemu)")
    if args.jobs < 1:
        parser.error("--jobs must be positive")
    if set(ids) - cases.keys():
        parser.error("no probe for one or more IDs")
    if args.check:
        inventory = (root / "gwbasic/EQUIVALENCE.md").read_text()
        statuses = {int(n): status for n, status in re.findall(
            r"^\| (\d+) \| [^|]+ \| [^|]+ \| (\w+) \|", inventory, re.M)}
        adapter = "vga" if args.qemu else os.environ.get("PCE_VIDEO", "vga")
        baseline = {r["id"]: r.get("adapters", {}).get(adapter, r) for r in map(json.loads,
                    (root / "test/gwaudit.jsonl").read_text().splitlines())}
        if baseline.keys() != cases.keys():
            parser.error("probe IDs differ from the recorded baseline")
        for n in ids:
            if statuses.get(n) not in ("Matched", "Different", "Inconclusive", "Intentional"):
                parser.error(f"case {n} has no recognized inventory status")
        counts = Counter()
    with tempfile.TemporaryDirectory() as tmp:
        folder = Path(tmp)
        template, data = folder / "boot.img", folder / "data.img"
        shutil.copyfile(os.environ.get("IMG", root / "media/msdos40-1440.img"), template)
        put(template, folder, "CONFIG.SYS", "FILES=30\nBUFFERS=20\n")
        put(template, folder, "AUTOEXEC.BAT", "@echo off\necho AUDIT READY\npause >nul\nb:\\run.bat\n")
        command("mformat", "-C", "-f", "1440", "-i", data, "::")
        put(data, folder, "SAMPLE.TXT", "ALPHA\n")
        put(data, folder, "TARGET.BAS", '10 GOTO 20\n20 OPEN "VALUE.OUT" FOR OUTPUT AS #2:PRINT #2,"TARGET";X:CLOSE:SYSTEM\n')
        for ext in ("ref", "exe"):
            install(data, root / ("gwbasic/gwbasic." + ext), ext + ".EXE")
        if live_editor:
            ref_results, exe_results = gweditpce.editor_results(
                folder, template, data, {n: editor[n] for n in ids}, put, read)
        elif not args.qemu:
            ref_results, exe_results = pce_group(ids, folder, template, data)
        else:
            with concurrent.futures.ThreadPoolExecutor(max_workers=min(args.jobs, 2)) as pool:
                ref_results, exe_results = pool.map(
                    lambda version: run_batch(ids, version, template, data), ("ref", "exe"))
        for n, ref, exe in zip(ids, ref_results, exe_results):
            result = {"id": n, "ref": ref, "exe": exe}
            if not args.check:
                print(json.dumps(result, sort_keys=True), flush=True)
                continue
            status = statuses[n]
            if any(not obs or obs.get("incomplete") for obs in (ref, exe)):
                reason = "incomplete observation"
            elif status == "Matched" and ref != exe:
                reason = "4.01N differs from 3.23"
            elif status == "Matched" and ref != baseline[n]["ref"]:
                reason = "both outputs differ from the recorded reference"
            elif status == "Different" and ref != baseline[n]["ref"]:
                reason = "reference observation changed"
            elif status == "Different" and exe != ref and exe != baseline[n]["exe"]:
                reason = "known difference changed"
            else:
                counts[status] += 1
                if status == "Different" and ref == exe:
                    print(f"REVIEW case {n}: previously different, now matches")
                continue
            counts["Failed"] += 1
            print(f"FAIL case {n}: {reason}; expected={baseline[n]!r} "
                  f"ref={ref!r} exe={exe!r}", file=sys.stderr, flush=True)
    if args.check:
        print(f"GW-BASIC {'QEMU' if args.qemu else 'PCE'} audit: " + ", ".join(
            f"{counts[k]} {k.lower()}" for k in
            ("Matched", "Different", "Inconclusive", "Intentional", "Failed")))
        return int(bool(counts["Failed"]))


if __name__ == "__main__":
    sys.exit(main())
