10 OPEN "CHECK.OUT" FOR OUTPUT AS #1:ON ERROR GOTO 900
15 DIM A%(15)
20 FOR M=9 TO 10:PRINT #1,"SCREEN";M
30 SCREEN M
40 FOR Y=0 TO 349 STEP 7:FOR X=0 TO 639 STEP 31:PSET (X,Y),((X\31)+(Y\7)) MOD 4:NEXT:NEXT
50 FOR Y=0 TO 349 STEP 7:FOR X=0 TO 639 STEP 31:IF POINT(X,Y)<>((X\31)+(Y\7)) MOD 4 THEN ERROR 200
60 NEXT:NEXT:PSET(639,349),3:PRINT #1,"CORNER";POINT(639,349)
70 PSET(2,3),17:PRINT #1,"LIMIT";POINT(2,3)
80 FOR X=0 TO 7:PSET(X,0),X MOD 4:NEXT
90 DEF SEG=&HA000:OUT &H3CE,4:FOR I=0 TO 3:OUT &H3CF,I:PRINT #1,PEEK(0);:NEXT:PRINT #1,:DEF SEG
95 LINE (200,120)-(210,126),1,B:PAINT (202,122),2,1:PRINT #1,"FILL";POINT(201,121);POINT(210,126);POINT(211,126)
96 GET (200,120)-(208,121),A%:PUT (30,30),A%,PSET:PRINT #1,"SPRITE";A%(0);A%(1);POINT(38,31)
97 PUT (30,30),A%,XOR:PRINT #1,"XOR";POINT(38,31)
98 PUT (30,30),A%,OR:PUT (30,30),A%,AND:PRINT #1,"AND";POINT(38,31)
99 PUT (30,30),A%,PRESET:PRINT #1,"PRESET";POINT(38,31)
100 SCREEN M,,1,0:PSET(639,349),1
110 SCREEN M,,0,1:PRINT #1,"PAGE 0";POINT(639,349)
120 SCREEN M,,1,0:PRINT #1,"PAGE 1";POINT(639,349)
125 PCOPY 0,1:PRINT #1,"COPY";POINT(639,349)
130 SCREEN 0
140 NEXT:PRINT #1,"DONE":CLOSE:SYSTEM
900 PRINT #1,"ERROR";ERR;ERL:IF ERL=30 AND ERR=5 THEN RESUME 140
910 IF ERL=100 AND ERR=5 THEN RESUME 130
920 CLOSE:SYSTEM
