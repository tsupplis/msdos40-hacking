10 OPEN "CHECK.OUT" FOR OUTPUT AS #1:ON ERROR GOTO 900
20 SCREEN 9:FOR Y=0 TO 349 STEP 7:FOR X=0 TO 639 STEP 31:PSET (X,Y),((X\31)+(Y\7)) MOD 4:NEXT:NEXT
30 FOR Y=0 TO 349 STEP 7:FOR X=0 TO 639 STEP 31:IF POINT(X,Y)<>((X\31)+(Y\7)) MOD 4 THEN ERROR 200
40 NEXT:NEXT:PSET(639,349),3:PRINT #1,POINT(639,349)
50 PSET(2,3),4
60 SCREEN 9,,1,0
70 PRINT #1,"DONE":CLOSE:SYSTEM
900 PRINT #1,ERR,ERL:IF ERL=50 THEN RESUME 60
910 IF ERL=60 THEN RESUME 70
920 CLOSE:SYSTEM
