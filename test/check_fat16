#!/usr/bin/env python3
"""Verify fragmented FAT16 reads and allocation above cluster 4095 in all layouts."""
from pathlib import Path
import argparse
import os
import shutil
import struct
import subprocess
import tempfile

from hmaprobe import install_probe

layouts = [("high", "dos=high,umb\ndevice=himem.sys"),
                           ("near", "dos=high"), ("far", "device=ramdrive.sys 80")]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("layout", nargs="?", choices=[row[0] for row in layouts])
selected = parser.parse_args().layout

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as name:
    tmp = Path(name)
    raw = tmp / "fat16.img"
    # XT geometry, one primary DOS partition beginning after the first track.
    sectors = 306 * 4 * 17
    offset = 17 * 512
    with raw.open("wb") as f:
        f.truncate(sectors * 512)
        mbr = bytearray(512)
        mbr[446:462] = struct.pack("<B3sB3sII", 0x80, bytes([1, 1, 0]), 4,
                                   bytes([3, 0x51, 49]), 17, sectors - 17)
        mbr[510:] = b"\x55\xaa"
        f.write(mbr)
    volume = f"{raw}@@{offset}"
    subprocess.run(["mformat", "-i", volume, "-T", str(sectors - 17), "-h", "4",
                    "-s", "17", "-H", "17", "-c", "2", "-v", "TEST16", "::"], check=True)
    with raw.open("r+b") as f:
        f.seek(offset + 3)
        f.write(b"MSDOS4.0")
    cluster_size = 2 * 512
    payload = bytes((i // cluster_size + i % 251) & 0xff for i in range(65792))
    # Store logical clusters 1 and 2 in reverse physical order. The first
    # allocation on this fresh volume starts at cluster 2.
    physical = (payload[:cluster_size] + payload[2*cluster_size:3*cluster_size]
                + payload[cluster_size:2*cluster_size] + payload[3*cluster_size:])
    (tmp / "source.bin").write_bytes(physical)
    with (tmp / "pad.bin").open("wb") as f:
        f.truncate(4300 * 1024)
    for file in ("source.bin", "pad.bin"):
        subprocess.run(["mcopy", "-i", volume, tmp / file, "::" + file.upper()], check=True)
    # Keep the directory entry and file size. Change 2 -> 3 -> 4 -> 5
    # into 2 -> 4 -> 3 -> 5 in both FATs, leaving the rest contiguous.
    with raw.open("r+b") as f:
        f.seek(offset + 22)
        fat_bytes = int.from_bytes(f.read(2), "little") * 512
        for fat in (offset + 512, offset + 512 + fat_bytes):
            f.seek(fat + 2 * 2)
            if struct.unpack("<3H", f.read(6)) != (3, 4, 5):
                raise RuntimeError("unexpected starting FAT16 chain")
            f.seek(fat + 2 * 2)
            f.write(struct.pack("<3H", 4, 5, 3))
    if subprocess.check_output(["mtype", "-i", volume, "::SOURCE.BIN"]) != payload:
        raise RuntimeError("fragmented source differs from the expected logical bytes")
    boot = tmp / "system.img"
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40_full.img"), boot)
    for binary in (root / "kernel/dos/msdos.sys", root / "kernel/bios/io.sys"):
        if subprocess.check_output(["mtype", "-i", boot, "::" + binary.name]) != binary.read_bytes():
            raise SystemExit(f"boot image differs from {binary}")
    subprocess.run(["mcopy", "-o", "-i", boot, root / "extra/pcehimem.sys", "::HIMEM.SYS"], check=True)
    batch = tmp / "fat.bat"
    install_probe(root, tmp, boot)
    workload = ("copy /b C:\\SOURCE.BIN C:\\RESULT.BIN\nfc /b C:\\SOURCE.BIN C:\\RESULT.BIN\n")
    # A 1 KiB directory cluster holds 32 slots, including "." and "..".
    workload += "md C:\\GROW\n"
    workload += "".join(f"echo {i}>C:\\GROW\\F{i:02}.TXT\n" for i in range(35))
    workload += ("del C:\\GROW\\F00.TXT\nren C:\\GROW\\F34.TXT LAST.TXT\n"
                 "echo reused>C:\\GROW\\REUSED.TXT\n"
                 "md C:\\DEST\nmove C:\\GROW\\F33.TXT C:\\DEST\\MOVED.TXT\n"
                 "ren C:\\GROW\\F3?.TXT F3?.BIN\n"
                 "ren C:\\GROW\\F01.TXT F02.TXT\n")
    for layout, config in layouts:
        if selected and layout != selected:
            continue
        batch.write_text(f"hmaio {layout[0]}!\n" + workload)
        batch.with_suffix(".cfg").write_text(config + "\n")
        disk = tmp / (layout + ".pimg")
        subprocess.run(["pce-img", "convert", "-q", "-g", "306", "4", "17",
                        "-O", "pimg", raw, disk], check=True)
        output = subprocess.check_output([root / "test/run_tests", batch],
                      env=dict(os.environ, IMG=str(boot), PCE_TEST_HD=str(disk))).splitlines()
        if output.count(b"LAYOUT PASS") != 1 or b"fc: no differences encountered" not in output or b"ENDTEST" not in output:
            raise RuntimeError(f"{layout}: {output!r}")
        saved = tmp / (layout + ".img")
        subprocess.run(["pce-img", "convert", "-q", "-O", "img", disk, saved], check=True)
        if subprocess.check_output(["mtype", "-i", f"{saved}@@{offset}", "::RESULT.BIN"]) != payload:
            raise RuntimeError(f"{layout}: persisted contents differ")
        part = saved.read_bytes()[offset:]
        fat_size = int.from_bytes(part[22:24], "little") * 512
        directory = 512 + 2 * fat_size
        if part[512:512+fat_size] != part[512+fat_size:directory]:
            raise RuntimeError(f"{layout}: FAT copies differ")
        root_entries = int.from_bytes(part[17:19], "little")
        if not any(part[i:i+11] == b"RESULT  BIN" and int.from_bytes(part[i+26:i+28], "little") > 4095
                   for i in range(directory, directory + 32 * root_entries, 32)):
            raise RuntimeError(f"{layout}: result did not exercise a high FAT16 cluster")
        # Read the persisted directory, including its extension and reused slot.
        grow_entry = next(i for i in range(directory, directory + 32 * root_entries, 32)
                          if part[i:i+11] == b"GROW       ")
        grow_cluster = int.from_bytes(part[grow_entry+26:grow_entry+28], "little")
        data_start = directory + ((root_entries * 32 + 511) // 512) * 512
        start = data_start + (grow_cluster - 2) * cluster_size
        entries = part[start:start+96]
        if (entries[:11] != b".          " or entries[32:43] != b"..         "
                or int.from_bytes(entries[26:28], "little") != grow_cluster
                or entries[58:60] != bytes(2) or entries[64:75] != b"REUSED  TXT"):
            raise RuntimeError(f"{layout}: invalid dot entries or deleted slot was not reused")
        for file, expected in [("GROW/LAST.TXT", b"34"), ("GROW/REUSED.TXT", b"reused"),
                               ("GROW/F01.TXT", b"1"), ("GROW/F02.TXT", b"2"),
                               ("GROW/F30.BIN", b"30"), ("GROW/F31.BIN", b"31"),
                               ("GROW/F32.BIN", b"32"), ("DEST/MOVED.TXT", b"33")]:
            if subprocess.check_output(["mtype", "-i", f"{saved}@@{offset}",
                                        f"::{file}"]).strip() != expected:
                raise RuntimeError(f"{layout}: bad directory contents for {file}")
        names = subprocess.check_output(["mdir", "-b", "-i", f"{saved}@@{offset}", "::GROW/"]).upper().splitlines()
        if any(name.rsplit(b"/", 1)[-1] in (b"F30.TXT", b"F31.TXT", b"F32.TXT", b"F33.TXT") for name in names):
            raise RuntimeError(f"{layout}: rename left a source entry")
        print("PASS FAT16", layout, flush=True)
