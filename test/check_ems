#!/usr/bin/env python3
"""Boot the shipped EMM386 on a 486 and exercise active BUFFERS /X."""
import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("mode", choices=("active", "low"), nargs="?", default="active")
switches = "/x /l" if parser.parse_args().mode == "low" else "/x"

root = Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(dir=root / "test/work") as work:
    folder = Path(work)
    boot = folder / "boot.img"
    data = folder / "data.img"
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40-1440.img"), boot)
    for binary in (root / "kernel/dos/msdos.sys", root / "kernel/bios/io.sys",
                   root / "kernel/memm/memm/emm386.sys"):
        if subprocess.check_output(["mtype", "-i", boot, "::" + binary.name]) != binary.read_bytes():
            raise SystemExit(f"EMS test image differs from {binary}")
    mode = re.search(r"0000:([0-9A-F]+) +BUF_EMS_MODE\b",
                     (root / "kernel/dos/msdos.map").read_text())[1]
    subprocess.run(["nasm", "-f", "bin", "-DBufEmsMode=0x" + mode, root / "test/emsread.asm",
                    "-o", folder / "emsread.com"], check=True)
    payload = bytes((i ^ (i >> 9)) & 255 for i in range(98304))
    (folder / "payload.bin").write_bytes(payload)
    subprocess.run(["mformat", "-C", "-f", "1440", "-i", data, "::"], check=True)
    subprocess.run(["mcopy", "-i", data, folder / "payload.bin", "::PAYLOAD.BIN"], check=True)
    (folder / "config.sys").write_bytes(f"device=emm386.sys 1024 ON\r\nbuffers=64 {switches}\r\n".encode())
    batch = ["@echo off", "ctty com1", "emsread", "if errorlevel 1 goto bad",
             "copy b:\\payload.bin b:\\result.bin", "if errorlevel 1 goto bad",
             "echo EMS PASS", "goto end", ":bad", "echo EMS FAILED", ":end"]
    (folder / "autoexec.bat").write_bytes(("\r\n".join(batch) + "\r\n").encode())
    subprocess.run(["mcopy", "-o", "-i", boot, folder / "config.sys", folder / "autoexec.bat",
                    folder / "emsread.com", "::"], check=True)
    serial = folder / "serial"
    args = ["qemu-system-i386", "-machine", "pc,accel=tcg", "-cpu", "486", "-m", "8",
            "-display", "none", "-monitor", "none", "-nic", "none", "-serial", f"file:{serial}",
            "-boot", "a", "-no-reboot"]
    for index, disk in enumerate((boot, data)):
        args.extend(["-drive", f"file={disk},if=floppy,index={index},format=raw"])
    with subprocess.Popen(args) as guest:
        try:
            deadline = time.monotonic() + 45
            while time.monotonic() < deadline and guest.poll() is None:
                output = serial.read_bytes() if serial.exists() else b""
                if b"EMS PASS\r\n" in output:
                    break
                if b"EMS FAILED" in output:
                    raise SystemExit("EMS cache activation or read-error recovery failed")
                time.sleep(0.1)
            else:
                raise SystemExit("EMS guest did not complete")
        finally:
            guest.terminate()
    if subprocess.check_output(["mtype", "-i", data, "::RESULT.BIN"]) != payload:
        raise SystemExit("EMS copy differs after shutdown")
    print("PASS active EMS cache, directory read error, retry and persisted copy")
