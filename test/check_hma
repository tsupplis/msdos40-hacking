#!/usr/bin/env python3
"""Exercise shared FCB, handle and device I/O on scratch boot layouts."""

import argparse
import os
from pathlib import Path
import shutil
import struct
import subprocess
import tempfile

from hmaprobe import install_asm_probe, install_probe

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("layout", nargs="?", choices=("high", "near", "far", "umb", "upperfallback", "fragmented"))
selected = parser.parse_args().layout

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as temp:
    folder = Path(temp)
    image = folder / "hma.img"
    source_image = Path(os.environ.get("IMG", root / "media/msdos40_full.img"))
    shutil.copyfile(source_image, image)
    for binary in (root / "kernel/bios/io.sys", root / "kernel/dos/msdos.sys"):
        embedded = subprocess.check_output(["mtype", "-i", image, "::" + binary.name])
        if embedded != binary.read_bytes():
            raise SystemExit(f"{source_image}: {binary.name} differs from {binary}")
    install_probe(root, folder, image)
    install_asm_probe(root, folder, image, "umbcheck")
    subprocess.run(["mcopy", "-o", "-i", image, root / "extra/pcehimem.sys", "::HIMEM.SYS"], check=True)
    for name in ("hmasvc", "procabrt"):
        probe = folder / (name + ".com")
        subprocess.run(["nasm", "-f", "bin", root / "test" / (name + ".asm"), "-o", probe], check=True)
        subprocess.run(["mcopy", "-i", image, probe, "::" + probe.name], check=True)
    # 128 distinct entries span two EXEC relocation-buffer reads.
    overlay = folder / "svcovl.exe"
    count = 128
    table = b"".join(struct.pack("<HH", 2 * i, 0) for i in range(count))
    header_size = (28 + len(table) + 15) & ~15
    payload = struct.pack("<128H", *range(count))
    length = header_size + len(payload)
    header = struct.pack("<14H", 0x5a4d, length % 512, (length + 511) // 512,
                         count, header_size // 16, 0, 0, 0, 0, 0, 0, 0, 28, 0)
    overlay.write_bytes((header + table).ljust(header_size, b"\0") + payload)
    subprocess.run(["mcopy", "-i", image, overlay, "::SVCOVL.EXE"], check=True)
    # Both EXEC modes run this MZ child and return its distinctive exit code.
    child = folder / "svcchild.exe"
    code = bytes.fromhex("b8 37 4c cd 21")
    header = struct.pack("<14H", 0x5a4d, 32 + len(code), 1, 0, 2, 16, 16,
                         0, 0x100, 0, 0, 0, 28, 0)
    child.write_bytes(header.ljust(32, b"\0") + code)
    subprocess.run(["mcopy", "-i", image, child, "::SVCCHILD.EXE"], check=True)
    batch = folder / "io.bat"

    for layout, config in (
        ("high", "dos=high, umb\ndevice=himem.sys"),
        ("umb", "dos=umb\ndevice=himem.sys"),
        ("upperfallback", "dos=high,umb\ndevice=umbs.sys ca00-e000"),
        ("fragmented", "dos=high,umb\ndevice=umbs.sys ca00-cc00 ce00-d000 d200-d400 d600-d800"),
        ("near fallback", "dos=high"),
        ("far fallback", "device=ramdrive.sys 80"),
    ):
        if selected and layout.split()[0] != selected:
            continue
        expected_layout = "n" if layout == "fragmented" else layout[0]
        commands = [f"hmaio {expected_layout}"]
        if layout == "high":
            commands = ["share", *commands, "hmaio s"]
        if layout in ("high", "umb", "upperfallback", "fragmented"):
            commands.extend(["umbcheck", "umbcheck"])
        commands.append("hmasvc")
        # Wildcard rename resumes the search through its own near entry.
        commands.extend([
            "md A:\\RENTEST",
            "echo one>A:\\RENTEST\\ONE.OLD",
            "echo two>A:\\RENTEST\\TWO.OLD",
            "ren A:\\RENTEST\\*.OLD *.NEW",
            "if exist A:\\RENTEST\\*.OLD goto rendone",
            "if not exist A:\\RENTEST\\ONE.NEW goto rendone",
            "if exist A:\\RENTEST\\TWO.NEW echo RENAME PASS",
            ":rendone",
            r"cd A:\RENTEST",
            "if not exist ONE.NEW goto dirdone",
            "cd A:\\",
            r"rd A:\RENTEST",
            r"if not exist A:\RENTEST\ONE.NEW goto dirdone",
            r"del A:\RENTEST\*.NEW",
            r"rd A:\RENTEST",
            r"if not direxist A:\RENTEST echo DIRECTORY PASS",
            ":dirdone",
        ])
        batch.write_text("\n".join(commands) + "\n")
        batch.with_suffix(".cfg").write_text(config + "\n")
        output = subprocess.check_output(
            [root / "test/run_tests", batch], env=dict(os.environ, IMG=str(image))
        )
        lines = output.splitlines()
        if "umbcheck" in commands:
            upper = [line for line in lines if line.endswith(b" UMB PASS")]
            if len(upper) != 2 or upper[0] != upper[1]:
                raise RuntimeError(f"child failed to release its UMB allocations: {lines!r}")
        expected = sum(cmd.startswith("hmaio ") for cmd in commands)
        required = (b"! OUTT PASS", b"HMA SERVICES PASS", b"RENAME PASS", b"DIRECTORY PASS", b"ENDTEST")
        if lines.count(b"HMA I/O PASS") != expected or any(line not in lines for line in required):
            raise RuntimeError(f"{layout}: {output.decode('cp437')}")
        batch.write_text("REM @blank-b\nprocabrt\n")
        output = subprocess.check_output(
            [root / "test/run_tests", batch], env=dict(os.environ, IMG=str(image))
        )
        if b"PROC ABORT PASS" not in output.splitlines():
            raise RuntimeError(f"{layout}: {output.decode('cp437')}")
        print("PASS", layout, flush=True)
