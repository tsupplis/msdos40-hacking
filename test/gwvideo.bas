10 OPEN "VIDEO.TXT" FOR OUTPUT AS #1
20 ON ERROR GOTO 200
30 FOR M=1 TO 2
40 SCREEN M:CLS
50 X=320*M-1:Y=199:C=2:IF M=2 THEN C=1
60 PSET (X,Y),C:PRINT #1,M,POINT(X,Y),POINT(X-1,Y)
70 LINE (3,2)-(9,5),1,BF:PRINT #1,POINT(3,2),POINT(9,5),POINT(2,2)
80 NEXT M
82 SCREEN 7:CLS
83 PSET (319,199),14:PRINT #1,POINT(319,199),POINT(318,199)
84 LINE (3,2)-(11,5),13,BF:PRINT #1,POINT(3,2),POINT(11,5),POINT(2,2)
85 COLOR 11,1:PSET (18,11):PRINT #1,POINT(18,11)
86 LINE (0,0)-(7,8),9,B:PAINT (3,3),12,9
87 PRINT #1,POINT(1,1),POINT(6,7),POINT(0,0),POINT(8,8)
90 SCREEN 0:PRINT #1,INSTR("HELLO","LL")
100 CLOSE:SYSTEM
200 PRINT #1,ERR,ERL:CLOSE:SYSTEM
