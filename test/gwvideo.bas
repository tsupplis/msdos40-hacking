10 OPEN "VIDEO.TXT" FOR OUTPUT AS #1
15 DIM A%(31)
20 ON ERROR GOTO 195
30 FOR M=1 TO 2
40 SCREEN M:CLS
50 X=320*M-1:Y=199:C=2:IF M=2 THEN C=1
60 PSET (X,Y),C:PRINT #1,M,POINT(X,Y),POINT(X-1,Y)
70 LINE (3,2)-(9,5),1,BF:PRINT #1,POINT(3,2),POINT(9,5),POINT(2,2)
80 NEXT M
82 SCREEN 7:CLS
83 PSET (319,199),14:PRINT #1,POINT(319,199),POINT(318,199)
84 LINE (3,2)-(11,5),13,BF:PRINT #1,POINT(3,2),POINT(11,5),POINT(2,2)
85 COLOR 11,1:PSET (18,11):PRINT #1,POINT(18,11)
86 LINE (0,0)-(7,8),9,B:PAINT (3,3),12,9
87 PRINT #1,POINT(1,1),POINT(6,7),POINT(0,0),POINT(8,8)
88 FOR M=7 TO 10:GOSUB 300:NEXT
90 SCREEN 0:PRINT #1,INSTR("HELLO","LL")
100 CLOSE:SYSTEM
195 IF M=10 AND ERL=300 AND ERR=5 THEN PRINT #1,"NO MONO BIOS":RESUME 90
200 PRINT #1,ERR,ERL:CLOSE:SYSTEM
300 SCREEN M:X=639:Y=349:C=3:IF M<=8 THEN Y=199
305 IF M=7 THEN X=319
310 IF M<10 THEN C=14
315 IF M=9 THEN COLOR 14,63
320 PSET (X,Y),C:PRINT #1,M,POINT(X,Y),POINT(X-1,Y),POINT(X,0)
330 LINE (200,120)-(210,126),1,B:PAINT (202,122),2,1
340 PRINT #1,POINT(201,121),POINT(210,126),POINT(211,126)
350 SCREEN M,,1,0:PSET (X,Y),1
360 SCREEN M,,0,1:PRINT #1,POINT(X,Y)
370 SCREEN M,,1,1:PRINT #1,POINT(X,Y)
380 LINE (11,15)-(19,16),3,BF:GET (11,15)-(19,16),A%
390 PUT (30,30),A%,PSET:PRINT #1,A%(0),A%(1),POINT(38,31),POINT(39,31)
400 PUT (30,30),A%,XOR:PRINT #1,POINT(38,31)
410 PUT (30,30),A%,OR:PUT (30,30),A%,AND:PRINT #1,POINT(38,31)
420 PUT (30,30),A%,PRESET:PRINT #1,POINT(38,31):RETURN
