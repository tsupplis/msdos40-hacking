#!/bin/sh
# Headless DOS test runner (PCE + mtools). Console output goes through COM1 (CTTY).
#
#   test/run_tests --list               list the test cases
#   test/run_tests <case>               run one case, e.g.  test/run_tests c_keyb
#   test/run_tests --all                run regression jobs with up to ten concurrent jobs
#   test/run_tests path/to/file.bat     run any batch file
#
# A case is test/cases/<name>.bat, optionally with <name>.cfg (extra CONFIG.SYS lines).
# Header lines in the .bat (they are also valid DOS REM comments):
#   REM @blank-b       drive B: is an unformatted floppy (default: freshly formatted 1.44M)
#   REM @seconds N     time allowed before the run is reported as a hang (default 40)
#
# Every run uses scratch copies in test/work/ (gitignored); media/ is never modified.
# The image is media/msdos40_full.img (override with IMG=...).
# A:\CR.TXT holds empty lines, to be used as input (< A:\CR.TXT) for "press any key" prompts.
# Limits: only DOS-handle output is captured; BIOS or direct-screen output and key input
# bypass CTTY, so interactive programs (select, fdisk menus) cannot be driven this way.
# Needs: pce-ibmpc, mtools, and the test PCE configuration.

set -e
cd "$(dirname "$0")/.."
CASES=test/cases
WORK=${PCE_TEST_WORK:-test/work}

list_cases() { for f in "$CASES"/*.bat; do basename "$f" .bat; done; }

case "${1:-}" in
  ""|-h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --list) list_cases; exit 0 ;;
  --regression-job)
    suite=$2
    job=$3
    export PCE_TEST_WORK="$suite/$job"
    mkdir "$PCE_TEST_WORK"
    case "$job" in
      check_*.*) set -- "$PWD/test/${job%.*}" "${job#*.}" ;;
      *)   set -- "$PWD/test/run_tests" "$job" ;;
    esac
    printf "[runner] START %s\n" "$job"
    if "$@" >"$PCE_TEST_WORK/output" 2>&1; then
      touch "$PCE_TEST_WORK/passed"
      printf "[runner] PASS %s\n" "$job"
    else
      printf "[runner] FAIL %s\n" "$job" >&2
      exit 1
    fi
    exit 0 ;;
  --all)
    mkdir -p test/work
    suite=$(mktemp -d "$PWD/test/work/regression.XXXXXX")
    # Schedule the independent disk layouts first; reboots within one layout
    # share its disk and must observe the previous boot's writes.
    set -- check_hma.high check_hma.near check_hma.far check_hma.umb check_hma.upperfallback check_hma.fragmented check_ems.active check_ems.low check_placement.tables check_dir32.near check_dir32.high check_fat16.high check_fat16.near \
      check_fat16.far check_harddisks.one check_harddisks.two check_harddisks.four check_harddisks.gap \
      check_harddisks.extended check_harddisks.logical check_harddisks.limit check_harddisks.chains check_harddisks.primaries check_harddisks.mixed check_harddisks.format check_harddisks.fdisk check_ifs.low check_ifs.high check_edit.high check_edit.near check_edit.far $(list_cases)
    status=0
    printf '%s\n' "$@" | xargs -n 1 -P 10 "$PWD/test/run_tests" --regression-job "$suite" || status=1
    for job do
      echo "##### $job"
      if [ -f "$suite/$job/output" ]; then cat "$suite/$job/output"; fi
      if [ -f "$suite/$job/passed" ]; then
        rm -rf "$suite/$job"
      else
        echo "[runner] FAILED $job; files in $suite/$job" >&2
        status=1
      fi
    done
    if [ "$status" -eq 0 ]; then rmdir "$suite"; fi
    exit "$status" ;;
esac

if [ -f "$1" ]; then BAT=$1
elif [ -f "$CASES/$1.bat" ]; then BAT=$CASES/$1.bat
else echo "no such test case: $1 (try: test/run_tests --list)" >&2; exit 2
fi
CFG=${BAT%.bat}.cfg
IMG=${IMG:-media/msdos40_full.img}

SECS=${SECS:-$(sed -n 's/^REM @seconds \([0-9][0-9]*\).*/\1/p' "$BAT" | head -1)}
SECS=${SECS:-40}

mkdir -p "$WORK"
rm -f "$WORK"/ser1.out "$WORK"/pce.log
cp "$IMG" "$WORK"/boot.img

# drive B:
if grep -q '^REM @blank-b' "$BAT"; then
  dd if=/dev/zero of="$WORK"/b.img bs=1474560 count=1 2>/dev/null
else
  rm -f "$WORK"/b.img
  mformat -C -f 1440 -v TESTB -i "$WORK"/b.img ::
fi

# AUTOEXEC.BAT = the case wrapped in CTTY COM1 ... CTTY CON
{ printf '@ECHO OFF\r\nMODE COM1:9600,N,8,1\r\nCTTY COM1\r\n'
  LC_ALL=C tr -d '\r' < "$BAT" | sed 's/$/\r/'
  printf 'ECHO ENDTEST\r\nCTTY CON\r\n'; } > "$WORK"/autoexec.tmp
mcopy -D o -i "$WORK"/boot.img "$WORK"/autoexec.tmp ::AUTOEXEC.BAT

printf '\r\n\r\n\r\n\r\n' > "$WORK"/cr.tmp
mcopy -D o -i "$WORK"/boot.img "$WORK"/cr.tmp ::CR.TXT

# CONFIG.SYS = the usual three lines + the case's .cfg, if any
{ printf 'BUFFERS=20\r\nFILES=20\r\nLASTDRIVE=E\r\n'
  if [ -f "$CFG" ]; then LC_ALL=C tr -d '\r' < "$CFG" | sed 's/$/\r/'; fi; } > "$WORK"/config.tmp
mcopy -D o -i "$WORK"/boot.img "$WORK"/config.tmp ::CONFIG.SYS

# Additional arguments attach scratch hard disks in BIOS order.
shift
python3 test/pcecfg.py "$WORK" ${PCE_TEST_HD:+"$PCE_TEST_HD"} "$@"

pce-ibmpc -c "$WORK"/pce.cfg -t null -g vga -r > "$WORK"/pce.log 2>&1 &
pid=$!
marker=$(printf 'ENDTEST\r')
completed() { grep -Fxq "$marker" "$WORK/ser1.out" 2>/dev/null; }
i=0
while [ "$i" -lt "$SECS" ]; do
  sleep 1; i=$((i+1))
  completed && break
done
kill $pid 2>/dev/null || true
sleep 1
kill -9 $pid 2>/dev/null || true
wait $pid 2>/dev/null || true

if [ -f "$WORK/ser1.out" ]; then LC_ALL=C tr -d '\r' < "$WORK/ser1.out"; fi
if ! completed; then
  echo "[runner] ENDTEST not seen within ${SECS}s (hang or crash?)" >&2
  exit 1
fi

# Batch cases report failed assertions over the serial console.
if grep -q '^FAILED ' "$WORK/ser1.out"; then
  exit 1
fi
