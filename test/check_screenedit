#!/usr/bin/env python3
"""Drive the distributed EDIT.EXE on DOS and check the persisted document."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import time

from pcecfg import write_config

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as tmp:
    folder = Path(tmp)
    def run(*args, **kwargs):
        subprocess.run(args, cwd=folder, check=True, **kwargs)

    image = folder / "boot.img"
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40_full.img"), image)
    if subprocess.check_output(["mtype", "-i", image, "::EDIT.EXE"]) != (root / "commands/edit/edit.exe").read_bytes():
        raise AssertionError("stale EDIT on test image")
    sample = (b"hello\tworld\r\n" + (b"a"*78+b"\r\n")*1800 +
              b"needle\nlast\x82")
    run("mformat", "-C", "-f", "1440", "-i", "b.img", "::")
    (folder / "source.txt").write_bytes(sample)
    run("mcopy", "-i", "b.img", "source.txt", "::SOURCE.TXT")
    fullcase = (b"test line "*100+b"\r\n")*200
    (folder / "full.txt").write_bytes(fullcase)
    run("mcopy", "-i", "b.img", "full.txt", "::FULL.TXT")
    (folder / "fill.bin").write_bytes(bytes(960000))
    run("mcopy", "-i", "b.img", "fill.bin", "::FILL.BIN")
    (folder / "auto.bat").write_bytes(b"@echo off\r\nprompt Q$G\r\nedit B:\\source.txt\r\nedit B:\\full.txt\r\nedit B:\\new.txt\r\nmode co40\r\nedit B:\\narrow.txt\r\nmode co80\r\necho DONE\r\n")
    run("mcopy", "-o", "-i", image, "auto.bat", "::AUTOEXEC.BAT")
    write_config(folder)
    with (folder / "pce.log").open("wb") as log:
        proc = subprocess.Popen(["pce-ibmpc", "-c", "pce.cfg", "-t", "null", "-g", "vga"],
                                cwd=folder, stdin=subprocess.PIPE, stdout=log, stderr=log)
        def send(command):
            proc.stdin.write((command + "\n").encode())
            proc.stdin.flush()

        def key(name):
            send(f"key {name}\nc 20000")

        def type_text(value):
            for ch in value:
                key("Space" if ch == " " else ch)

        def expect(suffix, anywhere=False):
            deadline = time.monotonic() + 30
            dump = folder / "screen.bin"
            screen = ""
            while time.monotonic() < deadline:
                dump.unlink(missing_ok=True)
                send('c 200000\nsave "screen.bin" bin b800:0 fa0')
                while not dump.exists() or dump.stat().st_size != 4000:
                    if proc.poll() is not None or time.monotonic() >= deadline:
                        raise RuntimeError(f"PCE screen capture timed out, last screen\n{screen}")
                    time.sleep(.01)
                data = dump.read_bytes()[::2].decode("cp437")
                screen = "\n".join(data[i:i+80].rstrip() for i in range(0, 2000, 80)).rstrip()
                if screen.endswith(suffix) or (anywhere and suffix in screen):
                    return dump.read_bytes()[1::2]
                if "EDIT FAIL" in screen:
                    break
            raise AssertionError(f"Expected {suffix!r}, screen was\n{screen}")

        try:
            expect("Ctrl-S Save", anywhere=True)
            expect("hello   world", anywhere=True)
            key("+Ctrl f -Ctrl")
            type_text("laste")
            attrs = expect("Find: laste", anywhere=True)
            assert 0x70 not in attrs[:23*80]
            key("F1")
            expect("Esc or F1 to return", anywhere=True)
            key("F1")
            expect("Find: laste", anywhere=True)
            key("ESC")
            key("+Ctrl +ShiftLeft")
            key("f")
            expect("Find (ignore case):", anywhere=True)
            key("-ShiftLeft -Ctrl")
            type_text("laste")
            attrs = expect("Find (ignore case): laste", anywhere=True)
            assert attrs[:23*80].count(0x70) == 5  # CP437 byte 82h folds to E
            key("ESC")
            expect("Ln 1/", anywhere=True)
            key("End")
            key("Backspace")
            key("x")
            key("Return")
            key("y")
            key("Home")
            key("Delete")
            key("Backspace")
            expect("hello   worlx", anywhere=True)
            key("+Ctrl f -Ctrl")
            type_text("needle")
            expect("Ln 1802/", anywhere=True)
            key("Return")
            key("End")
            key("1")
            key("+Ctrl q -Ctrl")
            expect("Unsaved changes", anywhere=True)
            key("+Ctrl s -Ctrl")
            expect("Saved.", anywhere=True)
            key("+Ctrl q -Ctrl")
            expect("EDIT B:\\full.txt", anywhere=True)
            key("x")
            key("+Ctrl s -Ctrl")
            expect("Save failed", anywhere=True)
            key("+Ctrl q -Ctrl")
            expect("Unsaved changes", anywhere=True)
            key("+Ctrl q -Ctrl")
            expect("EDIT B:\\new.txt", anywhere=True)
            type_text("new")
            key("Return")
            type_text("file")
            expect("Ln 2/2 Col 5", anywhere=True)
            # Select backwards across CRLF, copy, then paste at the end.
            key("+ShiftLeft")
            key("Up")
            key("Home")
            expect("Col 1", anywhere=True)
            key("-ShiftLeft")
            key("+Ctrl c -Ctrl")
            attrs = expect("Copied.", anywhere=True)
            assert attrs[:80] == bytes([0x70])*80 and attrs[80:84] == bytes([0x70])*4
            key("F1")
            expect("Esc or F1 to return", anywhere=True)
            key("x")  # modal help consumes editing keys
            key("ESC")
            restored = expect("Copied.", anywhere=True)
            assert restored[:160] == attrs[:160]
            expect("Ln 1/2 Col 1", anywhere=True)
            key("Down")
            key("End")
            key("+Ctrl v -Ctrl")
            expect("filenew", anywhere=True)
            key("+ShiftLeft")
            key("Home")
            expect("Col 1", anywhere=True)
            key("-ShiftLeft")
            key("+Ctrl x -Ctrl")
            expect("Cut.", anywhere=True)
            key("+Ctrl v -Ctrl")
            key("+ShiftLeft")
            key("Home")
            expect("Col 1", anywhere=True)
            key("-ShiftLeft")
            key("z")
            expect("Ln 3/3 Col 2", anywhere=True)
            key("+Ctrl +ShiftLeft")
            key("f")
            expect("Find (ignore case):", anywhere=True)
            key("-ShiftLeft -Ctrl")
            key("+ShiftLeft")
            key("n")
            key("-ShiftLeft")
            type_text("ew")
            expect("Ln 1/3 Col 1", anywhere=True)
            key("Return")
            key("x")
            key("+Ctrl s -Ctrl")
            expect("Saved.", anywhere=True)
            key("+Ctrl q -Ctrl")
            expect("narrow.txt", anywhere=True)
            key("F1")
            expect("Esc or F1 to return", anywhere=True)
            # In 40-column mode the prompt starts at cell 24*40.
            cells = (folder / "screen.bin").read_bytes()[::2]
            assert cells[960:979] == b"Esc or F1 to return"
            key("ESC")
            expect("narrow.txt", anywhere=True)
            key("+Ctrl q -Ctrl")
            expect("Q>")
        finally:
            if proc.poll() is None:
                send("quit")
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
    data = subprocess.check_output(["mtype", "-i", folder / "b.img", "::SOURCE.TXT"])
    assert data == sample.replace(b"world", b"worlx").replace(b"needle", b"needle1")
    print(f"PASS interactive EDIT on {len(sample):,} bytes, saved file verified")
    assert subprocess.check_output(["mtype", "-i", folder / "b.img", "::FULL.TXT"]) == fullcase
    assert subprocess.check_output(["mtype", "-i", folder / "b.img", "::NEW.TXT"]) == b"xnew\r\nfilenew\r\nz"
    print("PASS shifted selection, copy/cut/paste, replacement and both search modes")
    print("PASS full disk preserved original and dirty buffer; created new file")
