#!/usr/bin/env python3
"""Check SORT output byte for byte on a disposable DOS floppy."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
cases = {
    "empty": (b"", b""),
    "noeol": (b"b\r\na", b"a\r\nb\r\n"),
    "one": (b"x", b"x\r\n"),
    "blank": (b"b\r\n\r\na\r\n", b"\r\na\r\nb\r\n"),
    "ctrlz": (b"b\r\na\x1aignored", b"a\r\nb\r\n"),
}
# Moving the last record to the front used to require a second copy of it.
a = b"a" * 31000
z = b"z" * 31000
cases["long"] = (z + b"\r\n" + a, a + b"\r\n" + z + b"\r\n")

with tempfile.TemporaryDirectory() as tmp:
    folder = Path(tmp)
    image = folder / "source.img"
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40-1440.img"), image)
    lines = []
    for name, (source, expected) in cases.items():
        path = folder / (name + ".in")
        path.write_bytes(source)
        subprocess.run(["mcopy", "-i", image, path, "::"], check=True)
        lines.extend([f"sort <{name}.in >b:\\{name}.out",
                      f"if errorlevel 1 echo FAILED {name}"])
    batch = folder / "check.bat"
    batch.write_text("\n".join(lines) + "\n")
    work = folder / "guest"
    subprocess.run([root / "test/run_tests", batch], check=True,
                   env=dict(os.environ, IMG=str(image), PCE_TEST_WORK=str(work)))
    for name, (_, expected) in cases.items():
        output = subprocess.check_output(["mtype", "-i", work / "b.img", "::" + name + ".out"])
        if output != expected:
            raise SystemExit(f"Incorrect SORT output for {name}")
        print("PASS", name)
