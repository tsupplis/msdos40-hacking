REM Commands: FORMAT, CHKDSK, SYS, COPY, FC on drive B:
REM @blank-b
REM @seconds 150
ECHO == format b:
ECHO.> A:\ANS.TXT
ECHO N>> A:\ANS.TXT
FORMAT B: /V:TESTVOL < A:\ANS.TXT | FIND /V "percent"
ECHO == chkdsk b:
CHKDSK B:
ECHO == sys b:
SYS B:
IF NOT EXIST B:\IO.SYS ECHO FAILED SYS missing IO.SYS
IF NOT EXIST B:\MSDOS.SYS ECHO FAILED SYS missing MSDOS.SYS
DIR B: /A
ECHO == copy and compare
COPY A:\COMMAND.COM B:\C2.COM
FC /B A:\COMMAND.COM B:\C2.COM
