#!/usr/bin/env python3
"""Check an interactive COMMAND prompt and a direct 0Ah caller on a scratch floppy."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import time

from hmaprobe import install_probe
from pcecfg import write_config

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("layout", nargs="?", choices=("near", "far", "high"))
layout = parser.parse_args().layout

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as tmp:
    folder = Path(tmp)
    def run(*args, **kwargs):
        subprocess.run(args, cwd=folder, check=True, **kwargs)

    image = folder / "boot.img"
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40-1440.img"), image)
    for binary in (root / "kernel/dos/msdos.sys", root / "kernel/bios/io.sys"):
        if subprocess.check_output(["mtype", "-i", image, "::" + binary.name]) != binary.read_bytes():
            raise SystemExit(f"editor test image differs from {binary}")
    setup = ""
    if layout:
        install_probe(root, folder, image)
        setup = f"hmaio {layout[0]}!\r\n"
        configs = {"near": "dos=high", "far": "device=ramdrive.sys 80",
                   "high": "dos=high,umb\ndevice=himem.sys"}
        (folder / "config.sys").write_bytes((configs[layout] + "\n").replace("\n", "\r\n").encode())
        if layout == "high":
            run("mcopy", "-o", "-i", image, root / "pce/pcehimem.sys", "::HIMEM.SYS")
        run("mcopy", "-o", "-i", image, "config.sys", "::CONFIG.SYS")
    shutil.copyfile(root / "test/editbuf.asm", folder / "editbuf.asm")
    env = dict(os.environ, EMU2_DRIVE_C=tmp)
    for tool, args in (("masm", "editbuf.asm,editbuf.obj;"),
                       ("link", "editbuf.obj,editbuf.exe,nul;")):
        run("emu2", root / f"sdk/bin/{tool}.exe", args, env=env)
    run("mcopy", "-i", image, "editbuf.exe", "::EDITBUF.EXE")
    (folder / "auto.bat").write_bytes(f"@echo off\r\nprompt Q$G\r\n{setup}editbuf\r\nif errorlevel 1 goto done\r\neditbuf\r\nif errorlevel 1 goto done\r\necho REPEAT PASS\r\n:done\r\necho on\r\n".encode())
    run("mcopy", "-o", "-i", image, "auto.bat", "::AUTOEXEC.BAT")
    write_config(folder)
    with (folder / "pce.log").open("wb") as log:
        pce = os.environ.get("PCE_HEADLESS") or "pce-ibmpc"
        proc = subprocess.Popen([pce, "-c", "pce.cfg", "-t", "null", "-g", "vga"],
                                cwd=folder, stdin=subprocess.PIPE, stdout=log, stderr=log)
        def send(command):
            proc.stdin.write((command + "\n").encode())
            proc.stdin.flush()

        def key(name):
            send(f"key {name}\nc 20000")

        def type_text(value):
            for ch in value:
                key("Space" if ch == " " else ch)

        def expect(suffix, anywhere=False):
            deadline = time.monotonic() + 30
            dump = folder / "screen.bin"
            screen = ""
            while time.monotonic() < deadline:
                dump.unlink(missing_ok=True)
                send('c 200000\nsave "screen.bin" bin b800:0 fa0')
                while not dump.exists() or dump.stat().st_size != 4000:
                    if proc.poll() is not None or time.monotonic() >= deadline:
                        if not screen:
                            binary = shutil.which(pce) or pce
                            raise RuntimeError(f"No first screen capture from {binary}. "
                                               "Set PCE_HEADLESS to a monitor-capable headless build.")
                        raise RuntimeError(f"PCE screen capture timed out, last screen\n{screen}")
                    time.sleep(.01)
                data = dump.read_bytes()[::2].decode("cp437")
                screen = "\n".join(data[i:i+80].rstrip() for i in range(0, 2000, 80)).rstrip()
                if screen.endswith(suffix) or (anywhere and suffix in screen):
                    return
                if "EDIT FAIL" in screen:
                    break
            raise AssertionError(f"Expected {suffix!r}, screen was\n{screen}")

        try:
            # The probe prints the next case letter after the last passing case.
            if layout:
                expect("LAYOUT PASS", anywhere=True)
            expect("REPEAT PASS", anywhere=True)
            expect("Q>")
            print("PASS direct 0Ah buffer cases A-M", flush=True)
            type_text("echo ac")
            key("Left")
            type_text("b")
            key("Down")
            expect("Q>echo abc")
            key("Return")
            expect("abc\n\nQ>")
            key("Return")
            type_text("   ")
            key("Return")
            key("Up")
            expect("Q>echo abc")
            type_text(" cancelled")
            key("+Ctrl c -Ctrl")
            expect("^C", anywhere=True)
            key("Return")
            key("Up")
            expect("Q>echo abc")
            key("Home")
            key("Delete")
            type_text("e")
            key("End")
            key("Backspace")
            key("Return")
            expect("ab\n\nQ>")
            print("PASS COMMAND editing and caller-owned recall", flush=True)
            type_text("echo")
            key("Tab")
            type_text("xz")
            key("Left")
            key("+Ctrl h -Ctrl")
            expect("Q>echo  z")
            key("Home")
            type_text("x")
            expect("Q>xecho z")
            key("Escape")
            key("Return")
            expect("Q>")
            print("PASS tab repaint and Ctrl-H", flush=True)
            type_text("echo interrupted")
            key("+Ctrl c -Ctrl")
            expect("^C", anywhere=True)
            expect("Q>")
            type_text("echo recovered")
            key("Return")
            expect("recovered\n\nQ>")
            print("PASS Ctrl-C and prompt recovery", flush=True)
            # Fill the screen, then wrap and scroll while editing the last row.
            for _ in range(25):
                key("Return")
            type_text("echo " + "a"*75)
            expect("Q>echo " + "a"*73 + "\naa")
            key("Home")
            for _ in range(5):
                key("Right")
            type_text("b")
            expect("Q>echo b" + "a"*72 + "\naaa")
            key("Return")
            expect("b" + "a"*75 + "\n\nQ>")
            print("PASS wrapped redraw, scrolling and Enter in mid-line", flush=True)
        finally:
            if proc.poll() is None:
                send("quit")
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
