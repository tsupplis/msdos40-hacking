#!/usr/bin/env python3
"""Check COMP output using the built utility and disposable DOS disks."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as tmp:
    folder = Path(tmp)
    boot = folder / "comp.img"
    data_disk = folder / "data.img"
    subprocess.run(["mformat", "-C", "-f", "360", "-i", data_disk, "::"], check=True)
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40-1440.img"), boot)
    def install(image, path, name):
        subprocess.run(["mcopy", "-o", "-i", image, path, "::" + name], check=True)

    install(boot, root / "commands/comp/comp.com", "COMP.COM")
    # LF at the 4 KiB small-buffer boundary. The second fixture crosses the
    # 60 KiB large-buffer boundary where the two files exchange buffer roles.
    prefix = b"x" * 4094 + b"\r\n" + b"z" * (61440 - 4096)
    for name, data in {"LEFT": prefix + b"A\r\n!", "RIGHT": prefix + b"b\r\n!",
                       "X": b"Aa\r\nz", "Y": b"AA\r\n!tail", "Z": b"AA\r\n!",
                       "SAME": b"Aa\r\nz"}.items():
        path = folder / name
        path.write_bytes(data)
        install(data_disk, path, name)

    cases = [
        ("", ["COMP: Required parameters missing."]),
        ("B:\\X", ["COMP: Required parameters missing."]),
        ("B:\\X B:\\SAME", ["Files compare OK"]),
        ("B:\\X B:\\Z", ["OFFSET 1", "File 1 = 61", "File 2 = 41", "OFFSET 4"]),
        ("/D B:\\X B:\\Z", ["File 1 = 97", "File 2 = 65"]),
        ("B:\\X /A B:\\Z /L", ["LINE 1", "File 1 = a", "LINE 2", "File 2 = !"]),
        ("/C /L B:\\X B:\\Z", ["LINE 2", "File 1 = 7A"]),
        ("/C /N=1 B:\\X B:\\Y", ["Files compare OK"]),
        ("/N=2 /C B:\\X B:\\Y", ["OFFSET 4", "Files are different sizes"]),
        ("/N=1 B:\\LEFT B:\\RIGHT", ["Files compare OK"]),
        ("/L /D B:\\LEFT B:\\RIGHT", ["LINE 2", "File 1 = 65", "File 2 = 98"]),
        ("/N=oops B:\\X B:\\Y", ["Parameter format not correct"]),
    ]
    batch = folder / "comp.bat"
    batch.write_text("a:\n" + "".join(
        f"echo CASE{i}\na:\\comp {args}\n" for i, (args, _) in enumerate(cases)))
    output = subprocess.check_output([root / "test/run_tests", batch], text=True,
                                     env=dict(os.environ, IMG=str(boot), PCE_TEST_FLOPPY_B=str(data_disk)))
    blocks = output.split("CASE")[1:]
    if len(blocks) != len(cases):
        raise SystemExit(output)
    for (args, expected), block in zip(cases, blocks):
        if (any(s not in block for s in expected)
                or ("Files compare OK" in block) != ("Files compare OK" in expected)
                or (args.startswith("/C /L") and "LINE 1" in block)):
            raise SystemExit(f"FAIL {args}\n{block}")
    print(f"PASS {len(cases)} COMP cases")
