#!/usr/bin/env python3
"""Check command input, legacy listings, and the dates actually stored in FAT."""
import os
from pathlib import Path
import re
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as tmp:
    batch = Path(tmp) / "year.bat"
    commands = [
        "date 12-31-1999 <cr.txt", "echo old>early.y2k",
        "date 02-29-2000 <cr.txt", "echo new>later.y2k",
        "dir later.y2k", "dir /2Y later.y2k",
        "set DIRCMD=/2Y", "dir later.y2k", "dir later.y2k /-2y",
        "set DIRCMD=", "date <cr.txt",
    ]
    for year in ("00", "99", "980", "02000", "1979", "2100"):
        commands.append(f"date 01-01-{year} <cr.txt")
    commands += [
        "date <cr.txt",
        "md b:\\copies", "xcopy *.y2k b:\\copies /d:01-01-2000",
        "if exist b:\\copies\\early.y2k echo FAIL XCOPY cutoff",
        "if not exist b:\\copies\\later.y2k echo FAIL XCOPY cutoff",
        "xcopy *.y2k b:\\copies /d:01-01-99 <cr.txt",
        "if not errorlevel 1 echo FAIL XCOPY short year",
        "date 01-01-2000 <cr.txt", "echo edge>jan.y2k",
        "date 03-01-2000 <cr.txt", "echo edge>mar.y2k",
        "backup a:\\*.y2k b: /d:01-01-99 <cr.txt",
        "if not errorlevel 1 echo FAIL BACKUP short year",
        "backup a:\\*.y2k b: /d:01-01-2000 <cr.txt",
        "if errorlevel 1 echo FAIL BACKUP cutoff",
        "restore b: a:\\*.y2k /d /a:01-01-99 <cr.txt",
        "if not errorlevel 1 echo FAIL RESTORE short year",
        "restore b: a:\\*.y2k /d <cr.txt >archive.out",
        "if errorlevel 1 echo FAIL RESTORE list",
        "restore b: a:\\*.y2k /d /a:02-29-2000 /b:02-29-2000 <cr.txt >listing.out",
        "if errorlevel 1 echo FAIL RESTORE cutoff",
        "date 01-01-1980 <cr.txt", "echo min>min.y2k",
        "date 12-31-2099 <cr.txt", "echo max>max.y2k",
    ]
    batch.write_text("\n".join(commands) + "\n")
    out = subprocess.check_output([root / "test/run_tests", batch], env=os.environ).decode("cp437")
    def require(ok, message):
        if not ok:
            raise RuntimeError(message + "\n" + out)
    require("FAIL " not in out and "ENDTEST" in out, "command or filter failed")
    require(out.count("Current date is Tue 02-29-2000") == 2, "invalid input changed date")
    require(out.count("Enter new date (mm-dd-yyyy)") == 8, "prompt or rejection count")
    rows = re.findall(r"^LATER +Y2K +\d+ (.*)$", out, re.M)
    require(len(rows) == 4 and rows[0] == rows[3] and rows[1] == rows[2]
            and rows[0].startswith("02-29-2000 ") and rows[1].startswith("02-29-00 ")
            and rows[0].replace("2000", "00") == rows[1], "DIR layout or presets")
    image = work / "boot.img"
    listing = subprocess.check_output(["mtype", "-i", image, "::listing.out"]).upper()
    archive = subprocess.check_output(["mtype", "-i", image, "::archive.out"]).upper()
    require(b"EARLY.Y2K" not in archive and all(name in archive for name in
            (b"JAN.Y2K", b"LATER.Y2K", b"MAR.Y2K")), "BACKUP selection")
    require(b"LATER.Y2K" in listing and b"JAN.Y2K" not in listing
            and b"MAR.Y2K" not in listing, "RESTORE date bounds")
    raw = image.read_bytes()
    def word(pos):
        return int.from_bytes(raw[pos:pos + 2], "little")
    start = (word(14) + raw[16] * word(22)) * word(11)
    dates = {raw[pos:pos+11]: word(pos+24) for pos in range(start, start+word(17)*32, 32)}
    for name, year, month, day in (("EARLY",1999,12,31), ("LATER",2000,2,29),
                                   ("MIN",1980,1,1), ("MAX",2099,12,31)):
        require(dates.get((name.ljust(8)+"Y2K").encode()) == ((year-1980)<<9 | month<<5 | day),
                "wrong FAT timestamp on " + name)
    for country, valid, invalid, prompt in (
        ("049", "29.02.2000", "29.02.02000", "dd.mm.yyyy"),
        ("046", "2000-02-29", "02000-02-29", "yyyy-mm-dd"),
    ):
        batch.with_suffix(".cfg").write_text(f"COUNTRY={country},437,COUNTRY.SYS\n")
        batch.write_text(f"date {valid} <cr.txt\ndate {invalid} <cr.txt\n"
                         "date <cr.txt\necho test>locale.x\ndir locale.x\n")
        out = subprocess.check_output([root / "test/run_tests", batch]).decode("cp437")
        require(out.count("Invalid date") == 1 and out.count(prompt) == 2
                and f"Current date is Tue {valid}" in out
                and re.search(r"^LOCALE +X +\d+ " + re.escape(valid), out, re.M),
                "country date input, prompt or listing: " + country)
print("PASS four-digit dates, DIR legacy layout, archive filters and FAT timestamps")
