#!/usr/bin/env python3
"""Exercise COMMAND.COM directory conditionals on a disposable DOS boot."""
from pathlib import Path
import os
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
work = root / "test/work"
work.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(dir=work) as tmp:
    image = Path(tmp) / "source.img"
    shutil.copyfile(os.environ.get("IMG", root / "media/msdos40-1440.img"), image)
    subprocess.run(["mcopy", "-o", "-i", image, root / "commands/command/command.com",
                    "::COMMAND.COM"], check=True)
    subprocess.run(["mmd", "-i", image, "::HIDDIR"], check=True)
    subprocess.run(["mattrib", "-i", image, "+h", "+s", "::HIDDIR"], check=True)
    commands = ["b:", "md BASE", "cd BASE", "echo file>MIX1.TXT", "md MIX2"]
    cases = [
        ("DiReXiSt MIX2", True), ("direxist MIX1.TXT", False),
        ("direxist MISSING", False), ("direxist A:\\HIDDIR", True),
        ("direxist MIX*", True), ("direxist *.TXT", False),
        ("direxist .", True), ("direxist ..", True),
        ("direxist B:\\", True), ("direxist B:\\BASE\\MIX2\\", True),
        ("exist MIX2", False), ("exist MIX1.TXT", True),
    ]
    expected = []
    for i, (condition, result) in enumerate(cases):
        for negate in (False, True):
            marker = "MATCH%02d%d" % (i, negate)
            commands.append("if " + ("not " if negate else "") + condition + " echo " + marker)
            if result != negate:
                expected.append(marker)
    batch = Path(tmp) / "case.bat"
    batch.write_text("\n".join(commands) + "\n")
    output = subprocess.check_output([root / "test/run_tests", batch],
                                     env=dict(os.environ, IMG=str(image))).decode("cp437")
    actual = [line for line in output.splitlines() if line.startswith("MATCH")]
    assert actual == expected, (expected, output)
    print("PASS %d batch conditions" % (2 * len(cases)))
