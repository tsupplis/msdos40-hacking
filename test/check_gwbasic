#!/usr/bin/env python3
"""Exercise GW-BASIC's file and interactive entry points under emu2 or DOS."""
import argparse
import os
from pathlib import Path
import pty
import re
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--pce", action="store_true", help="boot the full DOS floppy")
args = parser.parse_args()

# Write to the default drive. The DOS batch runs on the scratch B: drive.
program = """10 OPEN "RESULT.TXT" FOR OUTPUT AS #1
20 PRINT #1,2+2
30 PRINT #1,INSTR("HELLO","LL")
40 FOR I=1 TO 3:S=S+I:NEXT:PRINT #1,S
50 SOUND 440,1:PRINT #1,"SOUND"
60 ON ERROR GOTO 100
70 OPEN "COM1:9600,N,8,1" AS #2
80 PRINT #1,"UNEXPECTED SERIAL OPEN":CLOSE:SYSTEM
100 PRINT #1,ERR:CLOSE:SYSTEM
"""
expected = b" 4 \r\n 3 \r\n 6 \r\nSOUND\r\n 57 \r\n"


def check_text(result, expected):
    # An FCB write can pad the last 128-byte record after the DOS text EOF.
    data, eof, _ = result.partition(b"\x1a")
    if data != expected or not eof:
        raise SystemExit(f"Expected {expected!r} and DOS EOF, got {result!r}")


with tempfile.TemporaryDirectory() as tmp:
    folder = Path(tmp)
    bas = folder / "smoke.bas"
    bas.write_bytes(program.replace("\n", "\r\n").encode("ascii") + b"\x1a")
    binary = root / "gwbasic/gwbasic.exe"
    if args.pce:
        image = folder / "source.img"
        shutil.copyfile(os.environ.get("IMG", root / "media/msdos40_full.img"), image)
        on_disk = subprocess.check_output(["mtype", "-i", image, "::GWBASIC.EXE"])
        if on_disk != binary.read_bytes():
            raise SystemExit("Full floppy and built GWBASIC.EXE differ")
        subprocess.run(["mcopy", "-o", "-i", image, bas, "::SMOKE.BAS"], check=True)
        graphics = root / "test/gwvideo.bas"
        subprocess.run(["mcopy", "-t", "-o", "-i", image, graphics, "::GWVIDEO.BAS"], check=True)
        # Seed an off-cursor text cell. A BIOS mode reset or CLS erases it.
        seed = folder / "seed.asm"
        seed.write_text("bits 16\norg 100h\nmov ax,0b800h\nmov es,ax\n"
                        "mov byte [es:1600],81\nret\n")
        subprocess.run(["nasm", "-f", "bin", seed, "-o", folder / "seed.com"], check=True)
        probe = folder / "probe.bas"
        probe.write_bytes(b'10 DEF SEG=&HB800:PRINT PEEK(1600):SYSTEM\r\n\x1a')
        input_probe = folder / "input.bas"
        input_probe.write_bytes(b'10 DEF SEG=&HB800:OPEN "INPUT.TXT" FOR OUTPUT AS #1\r\n'
                                b'20 PRINT #1,PEEK(1600):CLOSE:SYSTEM\r\n\x1a')
        for file in (folder / "seed.com", probe, input_probe):
            subprocess.run(["mcopy", "-o", "-i", image, file, "::"], check=True)
        batch = folder / "check.bat"
        batch.write_text("b:\na:gwbasic a:smoke.bas\na:gwbasic a:gwvideo.bas\n"
                         "ctty con\na:seed\na:gwbasic /nob a:probe.bas >stream.txt\n"
                         "a:seed\na:gwbasic a:input.bas <a:cr.txt\nctty com1\n")
        work = folder / "guest"
        subprocess.run([root / "test/run_tests", batch], cwd=root, check=True,
                       env=dict(os.environ, IMG=str(image), PCE_TEST_WORK=str(work)))
        stream = subprocess.check_output(["mtype", "-i", work / "b.img", "::STREAM.TXT"])
        if stream != b" 81 \r\n":
            raise SystemExit(f"Redirected screen marker or output changed: {stream!r}")
        input_result = subprocess.check_output(["mtype", "-i", work / "b.img", "::INPUT.TXT"])
        check_text(input_result, b" 81 \r\n")
        print("PASS independent stdin and stdout redirection preserve video memory")
        video = subprocess.check_output(["mtype", "-i", work / "b.img", "::VIDEO.TXT"])
        values, eof, _ = video.partition(b"\x1a")
        if not eof or [row.split() for row in values.splitlines()] != [
            [b"1", b"2", b"0"], [b"1", b"1", b"0"], [b"2", b"1", b"0"],
            [b"1", b"1", b"0"], [b"14", b"0"], [b"13", b"13", b"0"], [b"11"], [b"12", b"12", b"9", b"0"], [b"3"],
        ]:
            raise SystemExit(f"Unexpected graphics pixel results {video!r}")
        print("PASS SCREEN 1, 2 and 7 corner pixels, filled rectangles, COLOR, PAINT and return to text")
        result = subprocess.check_output(["mtype", "-i", work / "b.img", "::RESULT.TXT"])
    else:
        shutil.copyfile(binary, folder / "gwbasic.exe")
        env = dict(os.environ, EMU2_DRIVE_C=tmp)
        emu = os.environ.get("EMU2", "emu2")
        subprocess.run([emu, "gwbasic.exe", "smoke.bas"], cwd=folder, env=env,
                       check=True, timeout=10)
        result = (folder / "result.txt").read_bytes()
        (folder / "numeric.bas").write_bytes(b'10 PRINT "OK":SYSTEM\r\n\x1a')
        for memory in ("/M:49152", "/M:&HC000"):
            command = [emu, "gwbasic.exe", "/F:4", memory, "numeric.bas", "/S:128", "/C:128"]
            output = subprocess.check_output(command, cwd=folder, env=env, timeout=10)
            if output != b"OK\r\n":
                raise SystemExit(f"Numeric switches produced {output!r}")
    check_text(result, expected)
    print("PASS program file, arithmetic, INSTR, FOR/NEXT, SOUND, COM error and SYSTEM")

    if not args.pce:
        # Script keystrokes through the BIOS. A file argument bypasses the editor.
        def editor(arguments, keys, name):
            (folder / "keys.txt").write_text(keys)
            master, slave = pty.openpty()
            with os.fdopen(master, "rb"), os.fdopen(slave, "r+b", buffering=0) as terminal:
                subprocess.run([emu, "-s", "keys.txt", "-i", "150", "-d", "10",
                                "gwbasic.exe", *arguments], stdin=terminal, stdout=terminal,
                               cwd=folder, check=True, timeout=10,
                               env=dict(env, EMU2_DEBUG="video", EMU2_DEBUG_NAME=name))
            screen = (folder / f"{name}-video.0.log").read_bytes()
            return screen.rsplit(b"check_screen, redrawing", 1)[-1]

        rows = editor([], "print 2+2\nsystem\n", "editor")
        for pattern in (rb"^00: Microsoft GWBASIC Version 4\.01N +\r?$",
                        rb"^01: Copyright 1977-1982 \(C\) by Microsoft +\r?$",
                        rb"^03: Under MIT license +\r?$",
                        rb"^02: Copyright 2020-2022 \(C\) by D\. Spinellis, S\. Gros, T\.K\. Chia ",
                        rb"\d+: Ok", rb"\d+: print 2\+2", rb"\d+:  4 +\r?$",
                        rb"\d+: system"):
            if not re.search(pattern, rows, re.MULTILINE):
                raise SystemExit(f"Missing editor screen row matching {pattern!r}")
        print("PASS interactive Ok prompt, typed expression, displayed result and SYSTEM")

        (folder / "demo.bas").write_bytes(b'10 PRINT "RAN PROGRAM"\r\n20 SYSTEM\r\n\x1a')
        for i, arguments in enumerate((["/nOb", "/Nor", "demo.bas"],
                                       ["demo.bas", "/NoRun", "/NoBanner"])):
            rows = editor(arguments, "list\nrun\n", f"quiet{i}")
            if (b"Microsoft GWBASIC" in rows or b"Bytes free" in rows
                    or b"1LIST" in rows.upper()
                    or not re.search(rb'(?s)Ok.*list.*10 PRINT "RAN PROGRAM".*Ok.*run.*RAN PROGRAM', rows)):
                raise SystemExit(f"Unexpected quiet editor output {rows!r}")
        print("PASS quiet startup and load without running, full and abbreviated switches")
