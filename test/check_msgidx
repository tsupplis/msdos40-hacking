#!/usr/bin/env python3
"""Check that BUILDIDX and BUILDMSG see the same catalog section headers."""
import re
import sys
from pathlib import Path

catalog = Path(sys.argv[1]).read_bytes()
index = Path(sys.argv[2]).read_bytes().splitlines()
headers = []
for match in re.finditer(rb"^([A-Z][A-Z0-9 ]{7} [0-9a-fA-F]{4} [0-9]{4})\r?$",
                         catalog, re.MULTILINE):
    header = match[1]
    if int(header.split()[1], 16) != match.start():
        sys.exit(f"Incorrect catalog offset for {header.decode().strip()}")
    headers.append(header)
if not headers or index != [catalog.splitlines()[0], *headers]:
    sys.exit("Message index and catalog headers differ")
