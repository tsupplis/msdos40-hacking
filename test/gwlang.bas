10 REM Shared language and file cases adapted from cpm86-msbasic/tests.
20 OPEN "LANG.OUT" FOR OUTPUT AS #1:ON ERROR GOTO 9000
30 OPTION BASE 1:DIM A(3,4),S$(10)
40 FOR I=1 TO 3:FOR J=1 TO 4:A(I,J)=10*I+J:NEXT J,I
50 IF A(3,4)<>34 OR A(1,1)<>11 THEN ERROR 200
60 ERASE A:DIM A(2):A(1)=17:SWAP A(1),A(2):IF A(2)<>17 THEN ERROR 200
70 DATA 2,3,5:FOR I=1 TO 3:READ N:T=T+N:NEXT:RESTORE:READ N
80 DEF FNSQ(X)=X*X:IF FNSQ(N)+T<>14 THEN ERROR 200
90 PRINT #1,"arrays and control flow"
100 IF INT(-2.5)<>-3 OR FIX(-2.5)<>-2 OR (-7 MOD 3)<>-1 THEN ERROR 200
110 IF ABS(SIN(1)-.841471)>.000001 OR ABS(EXP(LOG(2))-2)>.00001 THEN ERROR 200
120 IF ABS(1#/3#*3#-1#)>1D-14 OR VAL("&H10")+VAL("&O17")<>31 THEN ERROR 200
130 IF CVI(MKI$(-1234))<>-1234 OR CVS(MKS$(1.25))<>1.25 OR CVD(MKD$(2.5#))<>2.5# THEN ERROR 200
140 PRINT #1,"math and conversions"
150 A$="hello world":MID$(A$,7,5)="WORLD":IF A$<>"hello WORLD" THEN ERROR 200
160 IF INSTR(4,"abcabc","c")<>6 OR INSTR("abc","")<>1 OR LEN("a"+CHR$(0)+"b")<>3 THEN ERROR 200
170 FOR I=1 TO 300:S$(1+(I MOD 10))=STRING$(100,65+(I MOD 26)):NEXT
180 F=FRE(""):FOR I=291 TO 300:IF S$(1+(I MOD 10))<>STRING$(100,65+(I MOD 26)) THEN ERROR 200
190 NEXT:PRINT #1,"strings and garbage collection"
200 PRINT #1,USING "###.##";3.14159
210 PRINT #1,USING "+##.#";-5
220 PRINT #1,USING "!";"hello"
230 OPEN "O",2,"SEQ.DAT":WRITE #2,"a,b",3.5,"c":PRINT #2,"line, with comma":CLOSE #2
240 OPEN "A",2,"SEQ.DAT":PRINT #2,"last":CLOSE #2
250 OPEN "I",2,"SEQ.DAT":INPUT #2,A$,B,C$:IF A$<>"a,b" OR B<>3.5 OR C$<>"c" THEN ERROR 200
260 LINE INPUT #2,A$:IF A$<>"line, with comma" THEN ERROR 200
270 LINE INPUT #2,A$:IF A$<>"last" OR NOT EOF(2) THEN ERROR 200
280 CLOSE #2:KILL "SEQ.DAT":PRINT #1,"sequential files"
290 OPEN "R",2,"RND.DAT",20:FIELD #2,10 AS N$,4 AS V$,6 AS R$
300 FOR I=1 TO 3:LSET N$="name"+STR$(I):LSET V$=MKI$(100*I):RSET R$=STR$(I):PUT #2,I:NEXT:CLOSE #2
310 OPEN "R",2,"RND.DAT",20:FIELD #2,10 AS N$,4 AS V$,6 AS R$:GET #2,2
320 IF N$<>"name 2    " OR CVI(V$)<>200 OR R$<>"     2" OR LOC(2)<>2 THEN ERROR 200
330 GET #2:IF CVI(V$)<>300 OR LOC(2)<>3 THEN ERROR 200
340 CLOSE #2:KILL "RND.DAT":PRINT #1,"random records"
345 MKDIR "GWTEST":CHDIR "GWTEST":OPEN "O",2,"LOCAL.DAT":PRINT #2,"inside":CLOSE #2:KILL "LOCAL.DAT":CHDIR "..":RMDIR "GWTEST"
346 T=TIMER:C$=TIME$:D=ABS(T-(VAL(LEFT$(C$,2))*3600!+VAL(MID$(C$,4,2))*60+VAL(RIGHT$(C$,2))))
347 IF D>2 AND D<86398! THEN ERROR 200
348 RANDOMIZE TIMER
349 OPEN "R",2,"EDGE.DAT",20:FIELD #2,20 AS V$:LSET V$="seventh":PUT #2,7:LSET V$="first":PUT #2,1:CLOSE #2
350 ON ERROR GOTO 500
351 OPEN "R",2,"EDGE.DAT",20:IF LOF(2)<>140 THEN ERROR 200
352 FIELD #2,20 AS V$:GET #2,7:IF LEFT$(V$,7)<>"seventh" THEN ERROR 200
353 CLOSE #2:KILL "EDGE.DAT"
354 CHDIR "NOEXIST"
355 ERROR 200
356 RMDIR "NOEXIST"
357 ERROR 200
360 A(0)=7
370 ERROR 200
380 PRINT #1,"resume and error line":PRINT #1,"COMPLETE":CLOSE:SYSTEM
490 REM Check both the error code and its origin.
500 IF ERR=76 AND ERL=354 THEN RESUME 356
505 IF ERR=76 AND ERL=356 THEN RESUME 360
507 IF ERR=9 AND ERL=360 THEN RESUME NEXT
510 IF ERR=200 AND ERL=370 THEN RESUME 380
9000 PRINT #1,"FAIL";ERR;" AT";ERL:CLOSE:SYSTEM
