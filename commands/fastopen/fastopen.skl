;==========================================================
;	FASTOPEN MESSAGE SKELETON FILE
;==========================================================

:util	FASTOPEN										   ;AN000;
:class	A			;System message class						   ;AN000;
:use 1	COMMON1 		;MSG 1 is always "Incorrect DOS Version"                           ;AN000;
:def 6 "FASTOPEN: Invalid parameter.",CR,LF
:def 3 "FASTOPEN: Invalid switch.",CR,LF

:def 4	CR,LF,"FASTOPEN installed",CR,LF                                                           ;AN000;
:def 5 "FASTOPEN: Already installed.",CR,LF
:def 7 "FASTOPEN: Invalid number of drives.",CR,LF
:def 8 "FASTOPEN: Invalid duplicate drive.",CR,LF
:def 9	CR,LF,"Invalid parameter",CR,LF                                                            ;AN000;
:def 11 "FASTOPEN: Invalid extent entry.",CR,LF
:def 12 "FASTOPEN: Invalid file/directory count.",CR,LF
:def 13 "FASTOPEN: Cannot set up expanded memory.",CR,LF
:def 14 "FASTOPEN: Expanded memory unavailable.",CR,LF
:def 15 "FASTOPEN: Invalid drive specification %1.",CR,LF
:def 16 "FASTOPEN: Invalid entry count for expanded memory.",CR,LF
:def 17 "FASTOPEN: Invalid drive %1 (local fixed drive required).",CR,LF
:def 18 "FASTOPEN: Invalid total extent count.",CR,LF
:def 19 "FASTOPEN: Invalid total file/directory count.",CR,LF

:def 20 "FASTOPEN: Required parameters missing.",CR,LF
:end

;==========================================================
