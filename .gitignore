# Build directories
build/

# Compiler and assembler artifacts
*.out
*.obj
*.lst
*.map
*.cod
*.crf
*.hex
*.prn
*.tsv
*.log
*.bak
*.lbr

# Generated message artifacts
*.ctl
*.cl[0-9]
*.cl[a-z]
*.clr
*.idx

# Generated include files
asminc/boot.inc
boot/boot.inc
boot/bootsec.bin
commands/fdisk/fdboot.inc
commands/fdisk/fdiskm.c
commands/select/panel.inf
commands/select/sel-pan.dat
commands/select/select.dat
commands/select/select.hlp

# Built binaries across directories
*.bin
*.sys
*.cpi
*.exe
*.com
*.img
*.lib

# Exceptions: vendor SDK tools, libraries, and source macro files
!sdk/bin/*.exe
!sdk/bin/*.com
!sdk/lib/*.lib
!sdk/lib/*.obj
!commands/append/sysmac.lib
!media/config.sys

# System files & editor temps
.DS_Store
.idxtmp/
.*.swp
*~

# Python cache
__pycache__/

# PCE ROM symlink / user binaries
/rom
/media/rom/

# Private/temporary files
private/
vm_*

# headless test scratch files (test/run.sh and the *.bat/*.cfg test scripts are kept)
test/*.img
test/*.tmp
test/*.out
test/*.log
test/t.cfg
